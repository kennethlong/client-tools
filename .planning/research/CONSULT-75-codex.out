  801: //-----------------------------------------------------------------------------
  802: bool AudioNamespace::queueSample(SoundBucketList & soundBucketList, Sound2 & sound, float 
const distanceSquared, bool const soundIsAlreadyPlaying)
  803: {
  804: 	bool result = true;
  805: 
  806: 	// See if the sound already exists in the bucket
  807: 
  808: 	SoundBucketList::iterator iterSoundBucketList = 
soundBucketList.find(&sound.getTemplate()->getCrcName());
  809: 
  810: 	if (iterSoundBucketList != soundBucketList.end())
  811: 	{
  812: 		SoundBucketData const & existingSound = iterSoundBucketList->second;
  813: 		bool playNewSound = false;
  814: 
  815: 		if (   distanceSquared < existingSound.m_distanceSquared
  816: 			|| (distanceSquared <= existingSound.m_distanceSquared && !sound.isInfiniteLooping()))
  817: 		{
  818: 			playNewSound = true;
  819: 		}
  820: 		else if (   !sound.isInfiniteLooping()
  821: 				 && (distanceSquared > 0.0f))
  822: 		{
  823: 			// The sound is further from the listener, but check to see if we want to play it anyways
  824: 
  825: 			int const totalTimeMs = sound.getTotalTime();
  826: 
  827: 			if (totalTimeMs > 0)
  828: 			{
  829: 				float const distancePercent = 1.0f - 
sqr(static_cast<float>(existingSound.m_distanceSquared) / static_cast<float>(distanceSquared));
  830: 				int const currentTimeMs = sound.getCurrentTime();
  831: 				float const playPercent = static_cast<float>(currentTimeMs) / 
static_cast<float>(totalTimeMs);
  832: 
  833: 				playNewSound = (playPercent > distancePercent);
  834: 			}
  835: 		}
  836: 
  837: 		// Sound already exists in the bucket, if the new sound is closer, play it and stop the 
previous sound
  838: 
  839: 		if (playNewSound)
  840: 		{
  841: 			// Kill previous sound, since the new one is closer
  842: 
  843: 			float const fadeOutTime = 0.0f;
  844: 			bool const keepAlive = iterSoundBucketList->second.m_sound->isInfiniteLooping();
  845: 
  846: 			AudioNamespace::stopSound(iterSoundBucketList->second.m_sound->getSoundId(), fadeOutTime, 
keepAlive);
  847: 			//DEBUG_REPORT_LOG(true, ("Audio::queueSample() 
iterSoundBucketList->second.m_sound->endOfSample(%s)\n", 
iterSoundBucketList->second.m_sound->getTemplate()->getName()));
  848: 
  849: 			// Insert the new sound
  850: 
  851: 			iterSoundBucketList->second.m_sound = &sound;
  852: 			iterSoundBucketList->second.m_distanceSquared = distanceSquared;
  853: 			iterSoundBucketList->second.m_soundIsAlreadyPlaying = soundIsAlreadyPlaying;
  854: 		}
  855: 		else
  856: 		{
  857: 			// The new sound is NOT a better choice that what already exists
  858: 
  859: 			result = false;
  860: 			//DEBUG_REPORT_LOG(true, ("Audio::queueSample() sound.endOfSample(%s)\n", 
sound.getTemplate()->getName()));
  861: 		}
  862: 	}
  863: 	else
  864: 	{
  865: 		// This sound is not in this bucket, add it
  866: 
  867: 		soundBucketList.insert(std::make_pair(&sound.getTemplate()->getCrcName(), 
SoundBucketData(&sound, distanceSquared, soundIsAlreadyPlaying)));
  868: 		//DEBUG_REPORT_LOG(true, ("Audio::queueSample() soundBucketList.insert(%s)\n", 
sound.getTemplate()->getName()));
