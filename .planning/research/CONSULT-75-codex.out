  318: //-----------------------------------------------------------------------------
  319: bool Sound2d::isDeletable() const
  320: {
  321: 	bool result = false;
  322: 	bool const inAudibleRange = getDistanceSquaredFromListener() <= 
sqr(getDistanceAtVolumeCutOff());
  323: 
  324: 	if (!inAudibleRange && !isInfiniteLooping())
  325: 	{
  326: 		result = true;
  327: 	}
  328: 	else
  329: 	{
  330: 		bool const parentObjectDied = (m_wasParented && (m_object == NULL));
  331: 		result = ((parentObjectDied || !isPlaying()) && m_autoDelete);
  332: 	}
  333: 
  334: 	return result;
  335: }
  336: 
  337: //-----------------------------------------------------------------------------
  338: bool Sound2d::isStillLooping() const
  339: {
  340: 	int const sampleCount = getTemplate()->getSampleCount();
  341: 	float const loopDelayMax = getTemplate()->getLoopDelayMax();
  342: 	bool loopingInHardware = (m_currentLoop > 0) && (loopDelayMax <= 0.0f) && (sampleCount <= 1);
  343: 	bool const infiniteLooping = isInfiniteLooping();
  344: 
  345: 	return ((m_currentLoop < m_loopCount) && !loopingInHardware) || infiniteLooping;
  346: }
