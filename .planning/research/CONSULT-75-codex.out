  805: // This sets up all the properties for how a new sample plays
  806: //-----------------------------------------------------------------------------
  807: void Sound2d::reset()
  808: {
  809: 	m_endOfSample = false;
  810: 	m_sampleStarted = false;
  811: 
  812: 	// Release the sample Id from the audio system
  813: 
  814: 	if (m_autoDelete &&
  815: 	    Audio::isSampleValid(m_sampleId))
  816: 	{
  817: 		Audio::releaseSampleId(*this);
  818: 		m_sampleId.invalidate();
  819: 	}
  820: 
  821: 	// Setup values for the next loop
  822: 
  823: 	if (isStillLooping())
  824: 	{
  825: 		setupNextSample();
  826: 		setupStartDelay();
  827: 		setupFadeIn();
  828: 		setupFadeOut();
  829: 		setupVolume();
  830: 		setupPitch();
  831: 	}
  832: }
