 5267: 		{
 5268: 			if (position_l.x > 0.0f)
 5269: 			{
 5270: 				if (position_l.x <= position_l.z)
 5271: 				{
 5272: 					// Front
 5273: 					result = AudioNamespace::queueSample(s_frontBucket, sound, distanceFromListenerSquared, 
soundIsAlreadyPlaying);
