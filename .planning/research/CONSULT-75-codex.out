 4379: void Audio::setSampleCurrentTime(SampleId const &sampleId, int const milliSeconds)
 4380: {
 4381: 	SampleIdToSample2dMap::iterator iterSampleIdToSample2dMap;
 4382: 	SampleIdToSample3dMap::iterator iterSampleIdToSample3dMap;
 4383: 	SampleIdToSampleStreamMap::iterator iterSampleIdToSampleStreamMap;
 4384: 
 4385: 	if (isSample2d(sampleId, iterSampleIdToSample2dMap))
 4386: 	{
 4387: 		if (milliSeconds == 0)
 4388: 		{
 4389: 			AIL_start_sample(iterSampleIdToSample2dMap->second.m_sample);
 4390: 		}
 4391: 		else
 4392: 		{
 4393: 			AIL_set_sample_ms_position(iterSampleIdToSample2dMap->second.m_sample, milliSeconds);
 4394: 		}
 4395: 	}
 4396: 	else if (isSample3d(sampleId, iterSampleIdToSample3dMap))
 4397: 	{
 4398: 		int const totalTime = getSampleTotalTime(sampleId);
 4399: 
 4400: 		if (totalTime > 0)
 4401: 		{
 4402: 			float const percent = static_cast<float>(milliSeconds) / static_cast<float>(totalTime);
 4403: 			float const sampleSize = 
static_cast<float>(getSampleSize(iterSampleIdToSample3dMap->second.getPath()->getString()));
 4404: 			unsigned int offset = static_cast<unsigned int>(sampleSize * percent);
 4405: 
 4406: 			offset -= offset % 4;
 4407: 
 4408: 			AIL_set_sample_position(iterSampleIdToSample3dMap->second.m_sample, offset);
 4409: 		}
 4410: 		else
 4411: 		{
 4412: 			DEBUG_REPORT_LOG(true, ("Audio::setSampleCurrentTime() - Unable to set the requested 3d 
sample time.\n"));
 4413: 		}
 4414: 	}
 4415: 	else if (isSampleStream(sampleId, iterSampleIdToSampleStreamMap))
 4416: 	{
 4417: 		if (milliSeconds == 0)
 4418: 		{
 4419: 			AIL_start_stream(iterSampleIdToSampleStreamMap->second.m_stream);
 4420: 		}
 4421: 		else
 4422: 		{
 4423: 			AIL_set_stream_ms_position(iterSampleIdToSampleStreamMap->second.m_stream, milliSeconds);
 4424: 		}
 4425: 	}
 4426: }
