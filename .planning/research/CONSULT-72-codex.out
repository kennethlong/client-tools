252:
253:	Object* createObject (const WorldSnapshotReaderWriter& reader, const 
WorldSnapshotReaderWriter::Node* const node, CreateErrorCode& result)
254:	{
255:		//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
256:
257:		if (NetworkIdManager::getObjectById (NetworkId (static_cast<NetworkId::NetworkIdType> 
(node->getNetworkIdInt ()))) != 0)
258:		{
259:			result = CEC_objectAlreadyExists;
260:			return 0;
261:		}
262:
263:		if (node->getContainedByNetworkIdInt () == 0 && node->getTransform_p ().getPosition_p () == 
Vector::zero)
264:		{
265:			result = CEC_orphanedAtOrigin;
266:			return 0;
267:		}
268:
269:		if (node->getContainedByNetworkIdInt () == 0 && node->getTransform_p ().getPosition_p 
().magnitudeSquared () < sqr (ms_closeToOriginDistance))
270:		{
271:			result = CEC_tooCloseToOrigin;
272:			return 0;
273:		}
274:
275:		//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
276:
277:		ClientObject *const object = instantiateObject(reader, node, result);
278:		if (!object)
279:		{
280:			return 0;
281:		}
282:
283:		//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
284:
285:		object->setClientCached();
286:		object->setTransform_o2p (node->getTransform_p ());
287:		object->setNetworkId (NetworkId (static_cast<NetworkId::NetworkIdType> (node->getNetworkIdInt 
())));
288:		object->createDefaultController();
289:
290:		DEBUG_REPORT_LOG(ms_reportWorldSnapshotCreates, ("start created %i [%s]\n", 
node->getNetworkIdInt (), reader.getObjectTemplateName (node->getObjectTemplateNameIndex ())));
291:
292:		RenderWorld::addObjectNotifications(*object);
293:	
294:		//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
295:		//-- begin the baselines
296:		object->beginBaselines ();
297:
298:		ContainedByProperty* const containedByProperty = object->getContainedByProperty ();
299:		NOT_NULL (containedByProperty);
300:
301:		const NetworkId::NetworkIdType containerId = node->getContainedByNetworkIdInt();
302:		containedByProperty->setContainedBy (NetworkId (containerId ) );
303:
304:		bool isCellObject = false;
305:
306:		PortalProperty* const portalProperty = object->getPortalProperty ();
307:		if (!portalProperty)
308:		{
309:			CellObject* const cellObject = dynamic_cast<CellObject*> (object);
310:			if (cellObject)
311:			{
312:				//-- handle cell objects (set cell index)
313:				cellObject->setCell (node->getCellIndex ());
314:
315:				isCellObject = true;
316:			}
317:			else
318:			{
319:				//-- handle all other objects (just add the notification)
320:				CellProperty::addPortalCrossingNotification (*object);
321:			}
322:		}
323:
324:		//-- does this object have any child nodes? don't create nodes for cell objects
325:		if (!isCellObject)
326:		{
327:			int i;
328:			for (i = 0; i < node->getNumberOfNodes (); ++i)
329:			{
330:				IGNORE_RETURN (createObject (reader, node->getNode (i), result));
331:
332:				//-- no need to check result because these objects are inside cells
333:			}
334:		}
335:
336:		//-- end the baselines
337:		object->endBaselines ();
338:		//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
339:
340:		DEBUG_REPORT_LOG(ms_reportWorldSnapshotCreates, ("  end created %i [%s]\n", 
node->getNetworkIdInt (), reader.getObjectTemplateName (node->getObjectTemplateNameIndex ())));
341:
342:		return object;
343:	}
