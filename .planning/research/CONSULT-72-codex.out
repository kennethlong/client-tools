211:
212:	ClientObject *instantiateObject(const WorldSnapshotReaderWriter& reader, const 
WorldSnapshotReaderWriter::Node* const node, CreateErrorCode& result)
213:	{
214:		//-- fetch the object template
215:		const SharedObjectTemplate * objectTemplate = fetchObjectTemplate(reader, node);
216:		if (!objectTemplate)
217:		{
218:			return 0;
219:		}
220:
221:		//-- verify that the portal layout crcs match
222:		{
223:			uint32 portalLayoutCrc = 0;
224:			if (!Game::getSinglePlayer() || !ConfigClientGame::getWorldSnapshotIgnorePobChanges())
225:			{
226:				if (PortalPropertyTemplate::extractPortalLayoutCrc (objectTemplate->getPortalLayoutFilename 
().c_str (), portalLayoutCrc))
227:				{
228:					if (portalLayoutCrc != static_cast<uint32> (node->getPortalLayoutCrc ()))
229:					{
230:						WARNING(true, ("WorldSnapshot createObject [%s] pob crc changed from [%d] to [%d]", 
231:							objectTemplate->getName(), static_cast<int>(node->getPortalLayoutCrc()), 
static_cast<int>(portalLayoutCrc)));
232:
233:						objectTemplate->releaseReference ();
234:						objectTemplate=0;
235:
236:						result = CEC_mismatchedPobCrc;
237:						return 0;
238:					}
239:				}
240:			}
241:		}
242:
243:		//-- instantiate the object
244:		ClientObject *const object = safe_cast<ClientObject*> (objectTemplate->createObject());
245:		objectTemplate->releaseReference();
246:		objectTemplate=0;
247:
248:		return object;
249:	}
