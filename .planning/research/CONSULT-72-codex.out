216:			ObjectList* const objectList = ms_objectList [i];
217:
218:			while (!objectList->isEmpty())
219:			{
220:				int const lastObjectIndex = objectList->getNumberOfObjects() - 1;
221:				Object *const object = objectList->getObject(lastObjectIndex);
222:				objectList->removeObjectByIndex(object, lastObjectIndex);
223:
224:				// do not delete contained objects, since their container will delete them
225:				if (!object->getAttachedTo())
226:					delete object;
227:			}
228:
229:			delete ms_objectList [i];
230:			ms_objectList [i] = 0;
231:		}
232:	}
233:
234:	//-- delete queuedObject list
235:	{
290:		MessageDispatch::Message<Object *> const msg(Messages::OBJECT_ADDED_PTR, object);
291:		ms_emitter.emitMessage(msg);
292:	}
293:
294:	//-- Add the object to the AlterScheduler.  This is the way that the system
