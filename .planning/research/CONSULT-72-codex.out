298:	else
299:		DEBUG_REPORT_LOG(ms_logUninitializedObjects, ("World::addObject(): skipping 
AlterScheduler::submitForAlter() on uninitialized object:pointer=[%p],id=[%s],template=[%s].\n", 
object, object->getNetworkId().getValueString().c_str(), object->getObjectTemplateName()));
