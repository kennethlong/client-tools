888:
889:void ClientWorld::remove ()
890:{
891:	DEBUG_FATAL (!ms_installed, ("ClientWorld::remove - not installed"));
892:	ms_installed = false;
893:
894:	//-- remove World
895:	World::remove ();
896:
897:	//-- verify the sphere trees are empty (they should have been cleared via World::remove)
898:	if (ms_tangibleSphereTree.getObjectCount () > 0)
899:	{
900:		DEBUG_WARNING (true, ("ClientWorld::remove: Tangible sphere tree not empty"));
901:		clearSphereTree (ms_tangibleSphereTree);
902:	}
903:
904:	if (ms_tangibleNotTargetableSphereTree.getObjectCount () != 0)
905:	{
906:		DEBUG_WARNING (true, ("ClientWorld::remove: TangibleNotTargetable sphere tree not empty"));
907:		clearSphereTree (ms_tangibleNotTargetableSphereTree);
908:	}
