1651:Object const * ClientWorld::findClosestCellObjectFromWorldPosition(Vector const & position_w)
1652:{
1653:	Object const * cellObject = &(CellProperty::getWorldCellProperty()->getOwner());
1654:
1655:	ObjectVector objects;
1656:	ms_tangibleSphereTree.findInRange(position_w, 1.0f, objects);
1657:
1658:	// ------------------------------------------------------------------------
1659:	// [ClientGame/ClientWorld] logCellAtPosition (default 0 = OFF). Standing
1660:	// DISCRIMINATOR probe for "this returned the WORLD cell when it should have
1661:	// returned a real one" (SWG-Toolkit, 2026-08-03: the world cell after
1662:	// game::loadScene, the real cell after a manual reload).
1663:	//
1664:	// There are exactly TWO ways to fall out of this function with the world
1665:	// cell, and they have completely different causes -- so the probe names
1666:	// which one happened instead of leaving it to inference:
1667:	//   candidates=0            -> the POB is not in ms_tangibleSphereTree at
1668:	//                              all (never created, or removed from the
1669:	//                              world and never re-added). A POPULATION bug.
1670:	//   candidates>0 portals=0  -> objects nearby but none is a POB.
1671:	//   idValid=0               -> the POB and the containing cell were BOTH
1672:	//                              found, and the cell was rejected only because
1673:	//                              its owner has no NetworkId. Client-created
1674:	//                              cells get one solely from the ClientObject
1675:	//                              ctor's `getSinglePlayer() || !getScene()`
1676:	//                              branch (ClientObject.cpp:296), so this is the
1677:	//                              reading to expect if that gate ever changes.
1678:	//
1679:	// 2026-08-07: added tree=T/N/F, the OCCUPANCY of all three tangible sphere
1680:	// trees (tangible / tangibleNotTargetable / tangibleFlora). candidates=0
1681:	// alone says only "this query found nothing" -- it does not distinguish
1682:	// three very different worlds, and the toolkit's editor-scene defect
1683:	// (candidates=0 at a position physically inside a building, offline only,
1684:	// never server-connected) sits on exactly that ambiguity:
1685:	//   tree=0/0/0              -> nothing is in ANY tangible tree. Whole-world
1686:	//                              population failure; the building is not the
1687:	//                              interesting part of the story.
1688:	//   tree=0/N>0/...          -> the trees are populated but the TANGIBLE one
1689:	//                              is empty. Objects are being routed to the
1690:	//                              wrong notification (this function only ever
1691:	//                              queries ms_tangibleSphereTree), which reads
1692:	//                              as candidates=0 while everything looks fine.
1693:	//   tree=T>0/...            -> the tangible tree is healthy and THIS BUILDING
1694:	//                              specifically is absent from it. A per-object
1695:	//                              add failure -- note the add gate is
1696:	//                              `getSpatialSubdivisionHandle() == 0` (:382),
1697:	//                              so an object holding a stale handle can never
1698:	//                              be re-added. removeFromWorld nulls it (:400);
1699:	//                              clearSphereTree (:238-251) does NOT, and runs
1700:	//                              in Release even though its warning does not.
1701:	// Printed on BOTH outcomes so a HIT gives the healthy baseline to compare
1702:	// the WORLD reading against.
1703:	// ------------------------------------------------------------------------
1704:	static int const s_logCellAtPosition = ConfigFile::getKeyInt("ClientGame/ClientWorld", 
"logCellAtPosition", 0);
1705:	int portalsSeen = 0;
1706:	int cellsRejectedForId = 0;
1707:
1708:	for (ObjectVector::const_iterator itObj = objects.begin(); itObj != objects.end(); ++itObj)
1709:	{
1710:		Object const * const object = *itObj;
1711:		if (object)
1712:		{
1713:			PortalProperty const * const portal = object->getPortalProperty();
1714:			if (portal)
1715:			{
1716:				++portalsSeen;
1717:
1718:				Vector const position_l = object->rotateTranslate_w2o(position_w);
1719:
1720:				CellProperty const * const cell = const_cast<PortalProperty 
*>(portal)->findContainingCell(position_l);
1721:				NetworkId const & containingCellId = cell->getOwner().getNetworkId();
1722:
1723:				if (containingCellId.isValid())
1724:				{
1725:					cellObject = &(cell->getOwner());
1726:
1727:					if (s_logCellAtPosition)
1728:						REPORT_LOG(true, ("[cellAtPos] HIT pos=<%1.2f,%1.2f,%1.2f> candidates=%d portals=%d 
tree=%d/%d/%d cell=%s building=%lld\n",
1729:							position_w.x, position_w.y, position_w.z, static_cast<int>(objects.size()), portalsSeen,
1730:							ms_tangibleSphereTree.getObjectCount(), 
ms_tangibleNotTargetableSphereTree.getObjectCount(), ms_tangibleFloraSphereTree.getObjectCount(),
1731:							cell->getCellName() ? cell->getCellName() : "(null)",
1732:							static_cast<long long>(object->getNetworkId().getValue())));
1733:
1734:					break;
1735:				}
1736:
1737:				++cellsRejectedForId;
1738:			}
1739:		}
1740:	}
1741:
1742:	if (s_logCellAtPosition && cellObject == &(CellProperty::getWorldCellProperty()->getOwner()))
1743:		REPORT_LOG(true, ("[cellAtPos] WORLD pos=<%1.2f,%1.2f,%1.2f> candidates=%d portals=%d 
tree=%d/%d/%d idValid=0 rejectedForId=%d\n",
1744:			position_w.x, position_w.y, position_w.z, static_cast<int>(objects.size()), portalsSeen,
1745:			ms_tangibleSphereTree.getObjectCount(), ms_tangibleNotTargetableSphereTree.getObjectCount(), 
ms_tangibleFloraSphereTree.getObjectCount(),
1746:			cellsRejectedForId));
1747:
1748:	return cellObject;
1749:}
