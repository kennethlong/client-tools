969:
970:void WorldSnapshot::loadStep ()
971:{
972:	if (!ms_parsePending)
973:		return;
974:
975:	float const budgetMs = static_cast<float> (ConfigClientGame::getWorldSnapshotParseBudgetMs ());
976:
977:	PerformanceTimer timer;
978:	timer.start ();
979:
980:	for (;;)
981:	{
982:		switch (ms_parsePhase)
983:		{
984:		case PP_wsNodes:
985:			{
986:				NOT_NULL (ms_parseIff);
987:
988:				float stepBudgetMs = 0.f;
989:				if (budgetMs > 0.f)
990:				{
991:					stepBudgetMs = budgetMs - timer.getSplitTime () * 1000.f;
992:					if (stepBudgetMs <= 0.f)
993:						return;
994:				}
995:
996:				if (ms_reader.stepIncrementalLoad (*ms_parseIff, stepBudgetMs))
997:				{
998:					//-- the Iff holds the whole .ws in RAM -- release it the
999:					//   moment the parse is done (the later phases don't need it)
1000:					delete ms_parseIff;
1001:					ms_parseIff = 0;
1002:					ms_parsePhase = PP_buildout;
1003:				}
1004:			}
1005:			break;
1006:
1007:		case PP_buildout:
1008:			{
1009:				const std::vector<BuildoutArea> &buildoutAreas = 
SharedBuildoutAreaManager::getBuildoutAreasForCurrentScene();
1010:				if (ms_buildoutAreaIndex < static_cast<int> (buildoutAreas.size ()))
1011:				{
1012:					loadOneBuildoutArea (buildoutAreas [static_cast<size_t> (ms_buildoutAreaIndex)]);
1013:					++ms_buildoutAreaIndex;
1014:				}
1015:				else
1016:					ms_parsePhase = PP_sphereTree;
1017:			}
1018:			break;
1019:
1020:		case PP_sphereTree:
1021:			{
1022:				//-- add all objects to the sphere tree (chunked by node index)
1023:				int const numberOfNodes = ms_reader.getNumberOfNodes ();
1024:				int const batchEnd = std::min (ms_sphereNodeIndex + 4096, numberOfNodes);
1025:				for (; ms_sphereNodeIndex < batchEnd; ++ms_sphereNodeIndex)
1026:				{
1027:					const WorldSnapshotReaderWriter::Node* const node = ms_reader.getNode (ms_sphereNodeIndex);
1028:
1029:					//
1030:					// if the object is not a buildout object
1031:					// or the object is a top level object
1032:					// then add it to the sphere tree
