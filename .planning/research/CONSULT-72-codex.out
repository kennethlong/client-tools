517:
518:void World::beginFrame ()
519:{
520:	DEBUG_FATAL (!ms_installed, ("not installed"));
521:
522:	if (ConfigSharedObject::getValidateWorld ())
523:		validate();
524:
525:	//-- add any queued objects to the world
526:	{
527:		for (int i = 0; i < ms_queuedObjectList->getNumberOfObjects (); ++i)
528:			ms_queuedObjectList->getObject (i)->addToWorld();
529:
530:		ms_queuedObjectList->removeAll ();
531:	}
532:}
