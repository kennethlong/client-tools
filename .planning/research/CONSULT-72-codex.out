1576:void WorldSnapshot::removeObject (const int64 networkIdInt)
1577:{
1578:	//-- CONSULT-60: a mid-parse miss here would let the node parse in later
1579:	//   WITHOUT the delete (duplicate object) -- finish the parse first
1580:	if (ms_parsePending)
1581:		finishLoadNow ();
1582:
1583:	const WorldSnapshotReaderWriter::Node* const node = ms_reader.find (networkIdInt);
1584:	if (node && !node->isDeleted () && node->getSpatialSubdivisionHandle ())
1585:	{
1586:		ms_sphereTree.removeObject (node->getSpatialSubdivisionHandle ());
1587:		node->setSpatialSubdivisionHandle (0);
1588:	}
1589:
1590:	ms_reader.removeNode (networkIdInt);
1591:}
1592:
1593://-------------------------------------------------------------------
1594:// Prevent a snapshot node from ever spawning again this session WITHOUT
1595:// destroying its authored data. The spawn set is the sphere tree, so
1596:// dropping the handle is the whole re-create prevention; removeObject's
1597:// additional removeNode tombstones+erases the AUTHORED row, which (a)
1598:// makes wsSetNodeTemplateName/find miss a building the server replaced,
1599:// (b) silently drops that authored row from every later wsSaveSnapshot
1600:// (tombstone-skip), and (c) makes the id allocator's map-miss free-test
1601:// see a still-authored id as free. Used by the SceneCreateObject
1602:// client-cached-replacement path (GroundScene), where the object is
1603:// merely superseded by the server-streamed copy -- the .ws data is not
1604:// being edited and must survive.
