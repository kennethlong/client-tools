851:
852:void ClientWorld::install (ClientWorld::CollisionDetectionFunction newCollisionDetectionFunction)
853:{
854:	InstallTimer const installTimer("ClientWorld::install");
855:
856:	DEBUG_FATAL (ms_installed, ("ClientWorld::install - already installed"));
857:	ms_installed = true;
858:
859:	//-- install World
860:	World::install ();
861:
862:	//-- set the collision function
863:	ms_collisionDetectionFunction = newCollisionDetectionFunction;
864:
865:	//-- create the cameraList
866:	ms_cameraList = new ObjectList (10);
867:
868:	//-- create the lightList
869:	ms_lightList = new ObjectList (100);
870:
871:	//--
872:	GroundEnvironment::install();
873:	ClientRegionEffectManager::install();
874:
875:#if PRODUCTION == 0
876:	DebugFlags::registerFlag(ms_disableCollision, "ClientGame/ClientWorld", "disableCollision");
877:	DebugFlags::registerFlag(ms_disableCollisionSorting, "ClientGame/ClientWorld", 
"disableCollisionSorting");
878:#endif
879:	DebugFlags::registerFlag(ms_concludePlayerOnly, "ClientGame/ClientWorld", "concludePlayerOnly");
880:	DebugFlags::registerFlag(ms_debugReport, "ClientGame/ClientWorld", "reportWorld", 
ClientWorld::debugReport);
881:	DebugFlags::registerFlag(ms_renderTangibleSphereTree, "ClientGame/ClientWorld", 
"renderTangibleSphereTree");
882:	DebugFlags::registerFlag(ms_renderTangibleNotTargetableSphereTree, "ClientGame/ClientWorld", 
"renderTangibleNotTargetableSphereTree");
883:	DebugFlags::registerFlag(ms_renderTangibleFloraSphereTree, "ClientGame/ClientWorld", 
"renderTangibleFloraSphereTree");
884:	DebugFlags::registerFlag(ms_logWorld, "ClientGame/ClientWorld", "logWorld");
885:}
