1070:void Object::addToWorld()
1071:{
1072:	if (m_inWorld)
1073:	{
1074:		DEBUG_WARNING(true, ("Object (%s : %s) is already in the world.", getObjectTemplateName(), 
getNetworkId().getValueString().c_str()));
1075:		return;
1076:	}
1077:
1078:	setObjectToWorldDirty(true);
1079:
1080:	m_inWorld = true;
1081:
1082:	if (m_appearance)
1083:		m_appearance->addToWorld();
1084:
1085:	{
1086:		PropertyList::iterator iEnd = m_propertyList->end();
1087:		for (PropertyList::iterator i = m_propertyList->begin(); i != iEnd; ++i)
1088:			(*i)->addToWorld();
1089:	}
1090:
1091:	m_notificationList->addToWorld(*this);
1092:
1093:	if (m_attachedObjects && !m_attachedObjects->empty())
1094:	{
1095:		const AttachedObjects::iterator iEnd = m_attachedObjects->end();
1096:		for (AttachedObjects::iterator i = m_attachedObjects->begin(); i != iEnd; ++i)
1097:			// Do not add attached child objects that are already in the world.
1098:			//   This happens when an object has a PortalProperty in its PropertyList.
1099:			if ((*i)->isChildObject() && !(*i)->isInWorld())
1100:				(*i)->addToWorld();
1101:	}
1102:}
