645:void WorldSnapshot::load (char const *sceneName)
646:{
647:	NOT_NULL(sceneName);
648:
649:	//-- clear the current snapshot
650:	//
651:	//   DO NOT "FIX" THIS BY MOVING THE ALREADY-LOADED TEST ABOVE IT (2026-08-04 --
652:	//   I tried, and it is strictly worse). This prologue running BEFORE the early
653:	//   return is the deliberate SAME-SCENE RE-STREAM path: emptying ms_loadedList
654:	//   makes update() treat every in-range node as needing creation again, so
655:	//   re-entering a scene rebuilds its objects from the ALREADY-PARSED ms_reader
656:	//   without paying for the .ws parse a second time. Note ms_sceneName is sticky
657:	//   across ~GroundScene (only engine_wsUnloadSnapshot clears it, :2947), so
658:	//   returning early here without clearing the loaded set would leave a
659:	//   re-entered scene EMPTY.
660:	//
661:	//   The invariant it depends on: the CALLER must already have destroyed the
662:	//   outgoing scene's objects (~GroundScene -> ClientWorld::remove ->
663:	//   World::remove). If they are still alive, this becomes the failure SWG-Toolkit
664:	//   reported as "game::loadScene leaves the snapshot incompletely populated until
665:	//   a manual reload" -- loaded set emptied, so every node is re-queued for
666:	//   creation, but every one of those creates then fails CEC_objectAlreadyExists
667:	//   against the surviving NetworkId, and nothing repopulates. That was a defect in
668:	//   the game::loadScene SHIM (it skipped the close+delete that all three engine
669:	//   scene installers do), not here. See engine_advertise.cpp engine_gameLoadScene.
670:	ms_loadedList.clear ();
671:	ms_reader.removeFromWorld ();
672:	ms_lastCellProperty = 0;
673:	ms_lastPosition_w.set (0.f, -9999.f, 0.f);
674:
675:	//-- see if we're already loaded
676:	if (_stricmp (sceneName, ms_sceneName.c_str ()) == 0)
677:	{
678:		DEBUG_REPORT_LOG (true, ("WorldSnapshot::load - %s is currently loaded\n", sceneName));
679:		return;
680:	}
681:
682:	ms_sceneName = sceneName;
683:	ms_unloadReason = "load";       // CONSULT-71 probe tag: zone change OR in-place reload's 
second unload
684:	unload ();
685:
686:	//-- CONSULT-60: cheap prologue only. The node parse, per-area buildout
687:	//   tables, and sphere-tree build all run in budgeted loadStep() calls
688:	//   pumped from GroundScene's loading update -- the old synchronous body
689:	//   froze the main loop ~3s inside the GroundScene constructor, BEFORE the
690:	//   loading screen was even enabled.
691:
692:#if PRODUCTION
693:	//always do block below [if ( true )]
694:#else
695:	if ( ConfigClientGame::getLoadBuildoutOnly() == false )
696:#endif
697:	{
698:		char filename[256];
699:		IGNORE_RETURN(snprintf(filename, sizeof(filename)-1, "snapshot/%s.ws", sceneName));
700:		filename[sizeof(filename)-1] = '\0';
701:
702:		ms_parseIff = new Iff;
703:		if (ms_parseIff->open (filename, true))
704:		{
705:			if (!ms_reader.beginIncrementalLoad (*ms_parseIff))
706:			{
707:				delete ms_parseIff;
708:				ms_parseIff = 0;
709:			}
710:		}
711:		else
712:		{
713:			delete ms_parseIff;
714:			ms_parseIff = 0;
715:
716:			//-- only warn if we don't have a buildout and are not in a space scene
717:			if (strncmp(sceneName, "space_", 6))
718:				DEBUG_WARNING (!SharedBuildoutAreaManager::isBuildoutScene(sceneName), ("WorldSnapshot::load 
- could not load %s", sceneName));
719:		}
720:	}
721:
722:	//-- the buildout-area LIST loads synchronously -- GroundScene::init reads
723:	//   it (getBuildoutNameForPosition) right after postload; only the per-area
724:	//   object tables are deferred
725:	SharedBuildoutAreaManager::load(sceneName);
726:
727:	ms_buildoutObjects.clear ();
728:	ms_buildoutTopLevelNodes.clear ();
729:	ms_buildoutAreaIndex = 0;
730:	ms_sphereNodeIndex = 0;
731:	ms_parsePhase = ms_parseIff ? PP_wsNodes : PP_buildout;
732:	ms_parsePending = true;
733:
734:	//-- budget <= 0 restores the old fully-synchronous load
735:	if (ConfigClientGame::getWorldSnapshotParseBudgetMs () <= 0)
736:		finishLoadNow ();
737:}
