273:void World::addObject (Object* object, int listIndex)
274:{
275:	DEBUG_FATAL (!ms_installed, ("not installed"));
276:	NOT_NULL (object);
277:	VALIDATE_RANGE_INCLUSIVE_EXCLUSIVE (0, listIndex, static_cast<int>(WOL_Count));
278:	DEBUG_FATAL (existsInList (object, listIndex), ("object already in list"));
279:	DEBUG_FATAL (existsInWorld (object), ("object already in world"));
280:
281:	ms_objectSet.insert(object);
282:	ms_objectList [listIndex]->addObject (object);
283:
284:	//-- notification of addition is guaranteed to occur AFTER the object is actually added
285:	{
286:		Emitter::ObjectMessage const msg(Messages::OBJECT_ADDED, 
std::make_pair(object->getNetworkId(), listIndex));
287:		ms_emitter.emitMessage(msg);
288:	}
289:	{
290:		MessageDispatch::Message<Object *> const msg(Messages::OBJECT_ADDED_PTR, object);
291:		ms_emitter.emitMessage(msg);
292:	}
293:
294:	//-- Add the object to the AlterScheduler.  This is the way that the system
295:	//   gives an object its first alter.
296:	if (object->isInitialized())
297:		AlterScheduler::submitForAlter(*object);
298:	else
299:		DEBUG_REPORT_LOG(ms_logUninitializedObjects, ("World::addObject(): skipping 
AlterScheduler::submitForAlter() on uninitialized object:pointer=[%p],id=[%s],template=[%s].\n", 
object, object->getNetworkId().getValueString().c_str(), object->getObjectTemplateName()));
