347:	void debugReport ()
348:	{
349:		DEBUG_REPORT_PRINT (true, ("-- WorldSnapshot\n"));
350:		DEBUG_REPORT_PRINT (true, ("  root objects = %i\n", ms_reader.getNumberOfNodes ()));
351:		DEBUG_REPORT_PRINT (true, (" total objects = %i\n", ms_reader.getTotalNumberOfNodes ()));
352:		DEBUG_REPORT_PRINT (true, ("     preloaded = %i\n", ms_preloadObjectTemplateList.size ()));
353:		DEBUG_REPORT_PRINT (true, ("        loaded = %i\n", ms_loadedList.size ()));
354:		DEBUG_REPORT_PRINT (true, ("         query = %i\n", ms_queryList.size ()));
355:		DEBUG_REPORT_PRINT (true, ("  sphere nodes = %i\n", ms_sphereTree.getNodeCount()));
356:		DEBUG_REPORT_PRINT (true, ("sphere objects = %i\n", ms_sphereTree.getObjectCount()));
