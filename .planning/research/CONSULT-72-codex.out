1606:void WorldSnapshot::suppressObject (const int64 networkIdInt)
1607:{
1608:	//-- same discipline as removeObject: a mid-parse miss would let the
1609:	//   node parse in later WITH its sphere handle (duplicate object)
1610:	if (ms_parsePending)
1611:		finishLoadNow ();
1612:
1613:	const WorldSnapshotReaderWriter::Node* const node = ms_reader.find (networkIdInt);
1614:	if (node && node->getSpatialSubdivisionHandle ())
1615:	{
1616:		ms_sphereTree.removeObject (node->getSpatialSubdivisionHandle ());
1617:		node->setSpatialSubdivisionHandle (0);
1618:	}
1619:}
