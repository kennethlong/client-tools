2599:	wsCollectSubtree (node, subtreeNodes, subtreeIds);
2600:
2601:	//-- (2) OCCUPANCY GUARD (load-bearing, ANSWERS 5.5), BIDIRECTIONAL since the
2602:	//   2026-07-18 cantina flag. Container::~Container cascade-deletes every
2603:	//   contained object -- deleting a POB with the player inside would delete
2604:	//   THEM -- but on server sessions the client does not necessarily link
2605:	//   occupants into the cell's Container CONTENTS (containment is server-
2606:	//   authoritative; the client tracks the occupant's render/physics cell via
2607:	//   Object::getParentCell). The contents walk and the delete cascade share
2608:	//   that blind spot symmetrically (which is why the flagged delete despawned
2609:	//   cleanly), but the occupant's parentCell would dangle into the deleted
2610:	//   building. So: (i) DOWNWARD -- the recursive contents walk (linked
2611:	//   containment; what the cascade would actually delete); (ii) UPWARD -- any
2612:	//   live non-client-cached object PARKED IN a subtree cell by parentCell,
2613:	//   regardless of contents linkage.
2614:	for (size_t i = 0; i < subtreeIds.size (); ++i)
2615:	{
2616:		Object* const object = NetworkIdManager::getObjectById (NetworkId 
(static_cast<NetworkId::NetworkIdType> (subtreeIds [i])));
2617:		if (object)
2618:		{
2619:			ClientObject* const clientObject = dynamic_cast<ClientObject*> (object);
2620:			if (!clientObject || !ContainerInterface::isClientCachedOnly (*clientObject))
2621:			{
2622:				WS_EDITOR_LOG (("[editor.ws] wsRemoveNode OCCUPIED (contents): root=%I64d subtree-id=%I64d 
holds a non-client-cached occupant (%s)\n", networkIdInt, subtreeIds [i], clientObject ? "in 
contents" : "not a ClientObject"));
2623:				return -1;   // "occupied" -- editor tells the user to step out first
2624:			}
2625:		}
2626:	}
2627:	{
2628:		std::set<int64> subtreeIdSet (subtreeIds.begin (), subtreeIds.end ());
2629:
2630:		const NetworkIdManager::NetworkIdObjectHashMap& allObjects = NetworkIdManager::getAllObjects 
();
2631:		for (NetworkIdManager::NetworkIdObjectHashMap::const_iterator iter = allObjects.begin (); 
iter != allObjects.end (); ++iter)
2632:		{
2633:			Object* const object = iter->second;
2634:			if (!object)
2635:				continue;
2636:
2637:			//-- cheap rejects first: most objects sit in the world cell
2638:			const CellProperty* const parentCell = object->getParentCell ();
2639:			if (!parentCell || parentCell == CellProperty::getWorldCellProperty ())
2640:				continue;
2641:
2642:			const int64 cellOwnerIdInt = parentCell->getOwner ().getNetworkId ().getValue ();
2643:			if (subtreeIdSet.find (cellOwnerIdInt) == subtreeIdSet.end ())
2644:				continue;
2645:
2646:			//-- standing inside this subtree. Subtree members despawn with the
2647:			//   building (correct); other CLIENT-CACHED objects re-seat via
2648:			//   streaming; a non-client-cached occupant (the player, any
2649:			//   server-streamed NPC/vendor) refuses the delete.
2650:			const int64 occupantIdInt = iter->first.getValue ();
2651:			if (subtreeIdSet.find (occupantIdInt) != subtreeIdSet.end ())
2652:				continue;
2653:
2654:			ClientObject* const clientObject = dynamic_cast<ClientObject*> (object);
2655:			if (!clientObject || !ContainerInterface::isClientCachedOnly (*clientObject))
2656:			{
2657:				WS_EDITOR_LOG (("[editor.ws] wsRemoveNode OCCUPIED (parent-cell): root=%I64d occupant=%I64d 
stands in cell-owner=%I64d (%s)\n", networkIdInt, occupantIdInt, cellOwnerIdInt, clientObject ? 
"non-client-cached" : "not a ClientObject"));
2658:				return -1;
2659:			}
2660:		}
2661:	}
2662:
2663:	//-- (3) sphere handle (root only -- children never hold handles)
2664:	if (node->getSpatialSubdivisionHandle ())
2665:	{
