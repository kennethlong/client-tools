161:{
162:	DEBUG_FATAL (ms_installed, ("World::install - already installed"));
163:	ms_installed = true;
164:
165:	//-- create the object lists
166:	int i;
167:	for (i = 0; i < static_cast<int>(WOL_Count); i++)
168:		ms_objectList [i] = new ObjectList (100);
169:
170:	ms_queuedObjectList = new ObjectList (100);
171:
172:#ifdef _DEBUG
173:	DebugFlags::registerFlag (ms_debugReport, "SharedObject", "reportWorld", debugReport);
174:	DebugFlags::registerFlag (ms_logUninitializedObjects, "SharedObject", 
"logWorldUninitializedObjects");
175:#endif
176:
177:	ms_lotManager = new LotManager (16384.f, 8.f);
178:
179:	ms_frameNumber = 0;
180:
205:	DEBUG_FATAL (!ms_installed, ("World::install - not installed"));
206:
207:	ms_valid = false;
208:
209:	//-- tell the appearance template list we no longer allow timed templates (this will delete all 
exiting timed templates)
210:	AppearanceTemplateList::setAllowTimedTemplates (false);
211:
212:	//-- delete all objectLists
213:	{
214:		for (int i = 0; i < static_cast<int>(WOL_Count); ++i)
