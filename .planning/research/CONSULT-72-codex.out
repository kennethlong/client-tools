501:
502:void World::validate ()
503:{
504:	for (int i = 0; i < static_cast<int> (WOL_Count); ++i)
505:	{
506:		for (int j = 0; j < getNumberOfObjects (i); ++j)
507:		{
508:			const Object* const object = getObject (i, j);
509:
510:			if (!object->isInWorld ())
511:				DEBUG_FATAL (true, ("World::validate - object [%s] in world object list %i wasn't in the 
world", object->getNetworkId ().getValueString ().c_str (), i));
512:		}
513:	}
514:}
