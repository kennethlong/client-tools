959:void WorldSnapshotNamespace::finishLoadNow ()
960:{
961:	//-- CONSULT-60 exactness valve: run the remaining parse to completion
962:	//   synchronously. Callers use this when they need complete snapshot data
963:	//   mid-parse; worst case degrades to the old synchronous-load cost.
964:	while (ms_parsePending)
965:		WorldSnapshot::loadStep ();
966:}
