169:	FATAL(FAILED(hresult) || !state, ("Direct3d11: CreateBlendState failed (%s). Binding null 
instead would silently revert to no blending.", Direct3d11_Device::describeHresult(hresult)));
170:
171:	++Direct3d11_Metrics::stateObjectCreations;
172:	IGNORE_RETURN(ms_blendStates.insert(std::make_pair(description, state)));
