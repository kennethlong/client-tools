282:	// USAGE / BindFlags matrix (per PATTERNS Â§interfaces resource matrix):
283:	//   render-target -> USAGE_DEFAULT + BIND_RENDER_TARGET|BIND_SHADER_RESOURCE
284:	//   dynamic       -> USAGE_DYNAMIC + BIND_SHADER_RESOURCE + CPU_ACCESS_WRITE
285:	//   static        -> USAGE_DEFAULT + BIND_SHADER_RESOURCE
286:	//
287:	// USAGE_IMMUTABLE would be ideal for static textures but requires
288:	// initial data at create-time. The engine creates the resource here
289:	// then writes via lock()/unlock() (Texture::loadSurface), so we cannot
290:	// use IMMUTABLE without restructuring the load path. USAGE_DEFAULT +
291:	// UpdateSubresource path is the correct mapping; UpdateSubresource is
292:	// invoked via the lock/unlock virtuals below using a staging buffer.
293:
294:	D3D11_USAGE usage         = D3D11_USAGE_DEFAULT;
295:	UINT        bindFlags     = D3D11_BIND_SHADER_RESOURCE;
296:	UINT        cpuAccessFlags = 0;
297:	UINT        miscFlags     = 0;
298:
299:	if (isRenderTarget)
300:	{
301:		usage     = D3D11_USAGE_DEFAULT;
302:		bindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
303:	}
304:	else if (isDynamic)
305:	{
306:		usage         = D3D11_USAGE_DYNAMIC;
307:		bindFlags     = D3D11_BIND_SHADER_RESOURCE;
308:		cpuAccessFlags = D3D11_CPU_ACCESS_WRITE;
309:	}
310:
