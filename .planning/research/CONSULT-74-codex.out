385:void Direct3d11_ConstantBuffersNamespace::flushPerObject()
386:{
387:	ID3D11DeviceContext1 * const context = Direct3d11_Device::getContext();
388:	if (!context)
389:		return;
390:
391:	if (ms_perObjectUsesRing)
392:	{
393:		if (ms_perObjectCursor >= cms_perObjectSlices)
394:		{
395:			// Wrapped. A DISCARD here is correct and is the only one this buffer
396:			// should ever see in a frame; more than one means the ring is too small
397:			// for the frame's draw count.
398:			ms_perObjectCursor = 0;
399:			++Direct3d11_Metrics::ringDiscards;
400:
401:			D3D11_MAPPED_SUBRESOURCE mapped;
402:			Zero(mapped);
403:			if (SUCCEEDED(context->Map(ms_perObjectRing, 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped)))
404:			{
405:				memcpy(mapped.pData, ms_perObject, cms_perObjectBytes);
406:				context->Unmap(ms_perObjectRing, 0);
407:			}
408:		}
409:		else
410:		{
411:			D3D11_MAPPED_SUBRESOURCE mapped;
412:			Zero(mapped);
413:			if (SUCCEEDED(context->Map(ms_perObjectRing, 0, D3D11_MAP_WRITE_NO_OVERWRITE, 0, &mapped)))
414:			{
415:				memcpy(static_cast<uint8 *>(mapped.pData) + (ms_perObjectCursor * cms_perObjectStride), 
ms_perObject, cms_perObjectBytes);
416:				context->Unmap(ms_perObjectRing, 0);
417:				++Direct3d11_Metrics::ringNoOverwrites;
418:			}
419:		}
420:
421:		UINT const firstConstant = static_cast<UINT>((ms_perObjectCursor * cms_perObjectStride) / 
cms_bytesPerRow);
422:		UINT const constantCount = static_cast<UINT>(cms_perObjectStride / cms_bytesPerRow);
423:		UINT const slot = Direct3d11_ConstantBuffers::PER_OBJECT_SLOT;
424:
425:		context->VSSetConstantBuffers1(slot, 1, &ms_perObjectRing, &firstConstant, &constantCount);
426:
427:		++ms_perObjectCursor;
428:	}
429:	else
430:	{
431:		ms_perObjectRotatingIndex = (ms_perObjectRotatingIndex + 1) & 3;
432:		ID3D11Buffer * const buffer = ms_perObjectRotating[ms_perObjectRotatingIndex];
433:
434:		D3D11_MAPPED_SUBRESOURCE mapped;
435:		Zero(mapped);
436:		if (SUCCEEDED(context->Map(buffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped)))
437:		{
438:			memcpy(mapped.pData, ms_perObject, cms_perObjectBytes);
439:			context->Unmap(buffer, 0);
440:			++Direct3d11_Metrics::ringDiscards;
441:		}
442:
443:		UINT const slot = Direct3d11_ConstantBuffers::PER_OBJECT_SLOT;
444:		context->VSSetConstantBuffers(slot, 1, &buffer);
574:void Direct3d11_ConstantBuffers::flush()
575:{
576:	ID3D11DeviceContext1 * const context = Direct3d11_Device::getContext();
577:	if (!context)
578:		return;
579:
580:	if (ms_vertexDirtyFirst >= 0)
581:	{
582:	// MAP_WRITE_DISCARD hands back a FRESH, UNINITIALISED buffer. Whatever was in it is gone, so a
583:	// partial copy does not leave the untouched rows alone -- it leaves them undefined.
584:	//
585:	// This used to copy only rows 0..dirtyLast, in the belief that bounding the upload by the dirty
586:	// extent saved bandwidth the way DX9's per-register SetVertexShaderConstantF did. It does not
587:	// mean that under DISCARD, and the cost was every constant ABOVE the dirty span, on every draw:
588:	// the hemispheric lighting block at c60..c63, the dot3 colours at c42..c43, and the unit
589:	// vectors seeded once at install into c49..c51. Any draw whose dirty span happened to stop
590:	// below those read garbage. That is why terrain and bump-lit walls rendered lavender while
591:	// unlit surfaces in the same frame were correct, and why the wrongness was stable per material
592:	// rather than flickering -- a material's dirty span is the same every frame.
593:	//
594:	// The whole shadow goes up now. It is 96 rows of 16 bytes for the vertex file and 25 for the
595:	// pixel one: about 1.5 KB and 400 bytes per flush, which is not worth being clever about. If it
596:	// ever is, the answer is UpdateSubresource on a non-dynamic buffer, or a NO_OVERWRITE ring --
597:	// not a partial DISCARD, which cannot be made correct.
