61:	DXGI_FORMAT_B4G4R4A4_UNORM,     // TF_ARGB_4444 (Win8+ only; install probe marks unsupported on 
older)
62:	DXGI_FORMAT_B5G5R5A1_UNORM,     // TF_ARGB_1555
63:	DXGI_FORMAT_B8G8R8X8_UNORM,     // TF_XRGB_8888
64:	DXGI_FORMAT_UNKNOWN,            // TF_RGB_888  -- no 24bpp packed in DXGI; engine promotes via 
runtimeFormats
65:	DXGI_FORMAT_B5G6R5_UNORM,       // TF_RGB_565
66:	DXGI_FORMAT_B5G5R5A1_UNORM,     // TF_RGB_555  -- closest DXGI; alpha bit unused by engine
67:	DXGI_FORMAT_BC1_UNORM,          // TF_DXT1
68:	DXGI_FORMAT_UNKNOWN,            // TF_DXT2     -- premultiplied BC2; no native DXGI variant; 
engine promotes
69:	DXGI_FORMAT_BC2_UNORM,          // TF_DXT3
70:	DXGI_FORMAT_UNKNOWN,            // TF_DXT4     -- premultiplied BC3; no native DXGI variant; 
engine promotes
71:	DXGI_FORMAT_BC3_UNORM,          // TF_DXT5
72:	DXGI_FORMAT_A8_UNORM,           // TF_A_8
73:	DXGI_FORMAT_R8_UNORM,           // TF_L_8      -- sample with .rrr swizzle in HLSL (Plan 11-05 
generators)
74:	DXGI_FORMAT_UNKNOWN,            // TF_P_8      -- palettized normal-map; D3D11 has no P_8; 
engine promotes
75:	DXGI_FORMAT_R16G16B16A16_FLOAT, // TF_ABGR_16F
76:	DXGI_FORMAT_R32G32B32A32_FLOAT, // TF_ABGR_32F
