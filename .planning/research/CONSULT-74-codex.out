486:	// runtime log on the same frame it fires. The Iter-18 BSOD established
487:	// that the next cbuffer-wiring bug MUST surface as a logged warning
488:	// BEFORE escalating to TDR -- without this drain in place, a bad
489:	// cbuffer-write would race the rasterizer to BSOD with no diagnostic
490:	// trace recoverable from disk.
491:
492:	if (createDeviceFlags & D3D11_CREATE_DEVICE_DEBUG)
493:	{
494:		HRESULT const qiHr = ms_device.As(&ms_infoQueue);
495:		if (SUCCEEDED(qiHr) && ms_infoQueue)
496:		{
497:			// Start with no filter -- capture every severity. Later
498:			// iterations can tighten if the steady-state log is too noisy.
499:			ms_infoQueue->PushEmptyStorageFilter();
500:
501:			// Corruption is unrecoverable -- break into debugger when
502:			// attached, or terminate the process when not. ERROR-severity
503:			// is downgraded to log-only (NOT break): the Iter-1 initial
504:			// configuration set ERROR=TRUE, which killed the smoke during
505:			// ShaderTemplate_Iff load of `lightsaberblade_lava_a.sht`
506:			// before drainInfoQueue() could log the actual D3D11 message
507:			// (DebugBreak fires synchronously when the message is added
508:			// to the queue, not when the queue is drained). The safety
509:			// net's intent is "early warning BEFORE TDR/BSOD" -- the LOG
510:			// is the early warning, not the BREAK. ERROR + WARNING + INFO
511:			// all flow through drainInfoQueue() each frame. CORRUPTION
512:			// stays TRUE because it's genuinely unrecoverable.
513:			ms_infoQueue->SetBreakOnSeverity(D3D11_MESSAGE_SEVERITY_CORRUPTION, TRUE);
514:			ms_infoQueue->SetBreakOnSeverity(D3D11_MESSAGE_SEVERITY_ERROR,      FALSE);
