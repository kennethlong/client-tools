338:	// cbuffer (1152 bytes, Direct3d11_VertexSlot0CB layout). Replaces Plan
339:	// 11-05's broken function-local-static shadow in Direct3d11.cpp's
340:	// setVertexShaderUserConstants_impl AND Plan 11-08's first-draw race
341:	// guard upload pattern. All slot 0 mutations (matrix setters + user
342:	// constants via setVSConstants) target this shadow + mark dirty; the
343:	// shadow is uploaded ONCE per applyPreDrawState (lazy flush per CODEX
344:	// Round 3 guidance: avoids dozens of Map(WRITE_DISCARD) per frame).
345:	//
346:	// Coherence with GPU: install() runs composeSlot0Shadow + flushes once
347:	// so shadow and GPU state both reflect identity matrices + zero defaults
348:	// (matches primeDefaults' install-time GPU upload).
349:	Direct3d11_VertexSlot0CB s_slot0Shadow = {};
350:	bool                     s_slot0Dirty = false;
351:
352:	// Compose WVP from current shadows + upload full Direct3d11_VertexSlot0CB
353:	// to slot 0. CODEX Q1 ratified order: wtp = P * V; wvp = wtp * W = P*V*W.
354:	// Direct port of D3D9 plugin's draw-time site at Direct3d9.cpp:4034
355:	// (D3DXMatrixMultiply(matrices+0, &ms_cachedWorldToProjectionMatrix,
356:	// &ms_cachedObjectToWorldMatrix) where ms_cachedWorldToProjectionMatrix
357:	// = P*V per Direct3d9.cpp:3291,3359). Per CODEX peer review,
358:	// XMMatrixMultiply(A, B) == D3DXMatrixMultiply(&out, &A, &B) with the
359:	// same row-major + row-vector + pre-multiplication semantics, so the
360:	// port is byte-for-byte equivalent.
361:	//
362:	// Per the cbuffer struct layout (Iter-2.5, verified against shader IR
363:	// dump stage/shader-iter13b-inc-0-output.txt lines 97-103):
364:	//   c0..c3   = objectWorldCameraProjectionMatrix (WVP)
365:	//   c4..c7   = objectWorldMatrix (World)
366:	//   c8       = cameraPosition_w (float3, world-space camera pos)
367:	//   c9       = viewportData     (float4, zero for now -- Task 4 if needed)
368:	//   c10      = fog              (float4, zero for now -- Task 4 if needed)
369:	//   c11..c71 = material / lightData / gap / extendedLightData / pad,
370:	//             all zero by {}-init (numLights = lightData[0].x = 0 is
371:	//             the shader-side loop-bomb guard per Iter-18 must-have #2).
372:	// Plan 11-09 Iter-2.7 Fix C: composes WVP from cached matrices into the
373:	// slot 0 shadow's c0..c3 + c4..c7 + c8 regions; marks shadow dirty so
374:	// the next applyPreDrawState flushes. Other shadow regions (c9..c71)
375:	// are preserved -- user constants pushed via setVSConstants land at
376:	// c52..c59 and lighting/material/etc. live elsewhere in slot 0.
377:	// Renamed from composeAndUploadSlot0 since the upload is now deferred
378:	// to flushSlot0IfDirty (called once per draw).
379:	void composeSlot0Shadow()
380:	{
381:		DirectX::XMMATRIX V   = DirectX::XMLoadFloat4x4(&s_cachedView);
382:		DirectX::XMMATRIX P   = DirectX::XMLoadFloat4x4(&s_cachedProj);
383:		DirectX::XMMATRIX W   = DirectX::XMLoadFloat4x4(&s_cachedWorld);
384:		DirectX::XMMATRIX wtp = DirectX::XMMatrixMultiply(P, V);     // P * V (CODEX Q1)
385:		DirectX::XMMATRIX wvp = DirectX::XMMatrixMultiply(wtp, W);   // (P * V) * W
386:
387:		// Plan 11-09.15 Iter-38B: TRANSPOSE before storing.
388:		//
389:		// Iter-38A2 captured V/P/W and demonstrated empirically that the
390:		// shader bytecode does row-vector left-multiply (`pos_row * M`) per
391:		// Cursor's disassembly, while the engine's source matrices are in
392:		// column-vector convention (translation in last *column*: W has
393:		// translation in W._14/_24/_34, not in row 3). For
394:		// `(M * pos_col)` semantics to come out of `(pos_row * stored)`, the
395:		// stored matrix must be the transpose of M.
396:		//
397:		// Verified by hand-walking sample #26 (terrain, identity W,
398:		// in-world): vertex 10 units in front of camera gives clip.w ~ +9.97
399:		// under (M * pos_col) (correct) but clip.w ~ -4.4e7 under
400:		// (pos_row * M) (catastrophic radial-fan symptom). Transposing M
401:		// makes (pos_row * M_T) = (M * pos_col).
402:		DirectX::XMMATRIX wvp_t = DirectX::XMMatrixTranspose(wvp);
403:		DirectX::XMMATRIX W_t   = DirectX::XMMatrixTranspose(W);
404:		DirectX::XMStoreFloat4x4(&s_slot0Shadow.objectWorldCameraProjectionMatrix, wvp_t);
