664:			//     * clip_WVP_col: WVP_alt     applied as column-vector right-mult
665:			//     * clip_WVP_row: WVP_alt     applied as row-vector left-mult
666:			//
667:			// The interpretation that produces clip.w POSITIVE for an in-front
668:			// vertex tells us the correct composition + convention pair. Iter-37A
