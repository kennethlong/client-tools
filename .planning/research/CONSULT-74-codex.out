165:// ----------------------------------------------------------------------
166:
167:// ======================================================================
168:// There is deliberately no invalidate().
169://
170:// One used to exist, for the benefit of a pass that bound its shaders and states straight to
171:// the context and then told the cache its shadows were stale. It could not work. Every field
172:// this cache shadows is a pointer, and NULL is a legal value for all of them -- a null pixel
173:// shader is what a pass with no pixel program binds, a null input layout is what a shader that
174:// reads no vertex buffer binds. So clearing the shadows to NULL did not say "nothing is known",
175:// it said "NULL is bound", and the very next bind of NULL was skipped as redundant. The scene
176:// target's composite left its own fullscreen pixel shader on the device that way, and the next
177:// material with no pixel program inherited it: a two-element interpolant signature against a
178:// twelve-element vertex output, which D3D11 rejects as a linkage error and does not draw.
179://
180:// Expressing "unknown" properly would mean a sentinel pointer value that cannot occur, or a
181:// validity flag beside every field. Both are machinery to support something nothing needs to
182:// do. Device state this cache shadows is set through this cache, and then the shadow is right
183:// by construction. auditAgainstDevice() is what keeps that true.
184:// ======================================================================
185:
186:void Direct3d11_StateCache::setBlendState(ID3D11BlendState *state, float const blendFactor[4], 
uint32 sampleMask)
187:{
188:	++Direct3d11_Metrics::blendStateBindCalls;
189:
190:	bool const factorMatches =
191:		ms_blendFactor[0] == blendFactor[0] &&
192:		ms_blendFactor[1] == blendFactor[1] &&
193:		ms_blendFactor[2] == blendFactor[2] &&
194:		ms_blendFactor[3] == blendFactor[3];
195:
196:	if (state == ms_blendState && sampleMask == ms_sampleMask && factorMatches)
197:		return;
198:
199:	ID3D11DeviceContext1 * const context = Direct3d11_Device::getContext();
200:	if (!context)
201:		return;
202:
203:	++Direct3d11_Metrics::blendStateBindMisses;
204:
205:	ms_blendState = state;
206:	ms_blendFactor[0] = blendFactor[0];
207:	ms_blendFactor[1] = blendFactor[1];
208:	ms_blendFactor[2] = blendFactor[2];
209:	ms_blendFactor[3] = blendFactor[3];
210:	ms_sampleMask = sampleMask;
211:
212:	context->OMSetBlendState(state, blendFactor, sampleMask);
213:}
214:
215:// ----------------------------------------------------------------------
216:/**
217: * Bind a depth-stencil state and its reference value.
218: *
219: * The reference is part of the binding call in D3D11, not a separate state as it
220: * was in D3D9, so a change to the reference alone still has to re-bind. Missing
221: * that is how a per-shader stencil reference silently becomes zero for every
222: * shadow after the first.
223: */
224:
225:void Direct3d11_StateCache::setDepthStencilState(ID3D11DepthStencilState *state, uint32 
stencilReference)
226:{
227:	++Direct3d11_Metrics::depthStencilStateBindCalls;
228:
229:	if (state == ms_depthStencilState && stencilReference == ms_stencilReference)
230:		return;
231:
232:	ID3D11DeviceContext1 * const context = Direct3d11_Device::getContext();
233:	if (!context)
234:		return;
235:
236:	++Direct3d11_Metrics::depthStencilStateBindMisses;
237:
238:	ms_depthStencilState = state;
239:	ms_stencilReference = stencilReference;
240:
241:	context->OMSetDepthStencilState(state, stencilReference);
242:}
