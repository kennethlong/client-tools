635:/**
636: * Change the size of the frame buffer.
637: *
638: * Note what DX9 does NOT do here: it does not resize the OS window. In windowed
639: * mode the smaller back buffer is stretched into the unchanged client area at
640: * Present, which is exactly how a cut scene displays a 640x480 video in a
641: * full-size window. DXGI_SCALING_STRETCH on the swap chain reproduces that, so
642: * the window is deliberately left alone.
643: */
644:
645:void Direct3d11_SwapChain::resize(int width, int height)
646:{
647:	DX11_ASSERT_MAIN_THREAD();
648:
649:	if (!ms_swapChain || width <= 0 || height <= 0)
650:		return;
651:
652:	if (width == ms_width && height == ms_height)
653:		return;
654:
655:	// The two real subscribers -- Bink's video surface and the post-processing
656:	// manager -- size their render targets to the frame buffer, so they have to
657:	// let go before the buffers change and rebuild afterwards.
658:	Direct3d11_Device::fireDeviceLost();
659:
660:	releaseBackBufferViews();
661:
662:	ms_width  = width;
663:	ms_height = height;
664:
665:	HRESULT const hresult = ms_swapChain->ResizeBuffers(0, static_cast<UINT>(width), 
static_cast<UINT>(height), DXGI_FORMAT_UNKNOWN, ms_swapChainFlags);
666:	Direct3d11_Device::checkForDeviceRemoved(hresult, "ResizeBuffers");
667:	FATAL(FAILED(hresult), ("Direct3d11: ResizeBuffers to %dx%d failed (%s).", width, height, 
Direct3d11_Device::describeHresult(hresult)));
668:
669:	IGNORE_RETURN(createBackBufferViews());
670:	IGNORE_RETURN(Direct3d11_SceneTarget::resize(width, height));

