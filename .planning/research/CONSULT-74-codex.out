109:// ----------------------------------------------------------------------
110:
111:void Direct3d11_DynamicIndexBufferData::recreateRing()
112:{
113:	ms_d3dRingBuffer.Reset();
114:
115:	ID3D11Device * const device = Direct3d11_Device::getDevice();
116:	NOT_NULL(device);
117:
118:	D3D11_BUFFER_DESC bd = {};
119:	bd.ByteWidth      = static_cast<UINT>(ms_numberOfIndices * static_cast<int>(sizeof(Index)));
120:	bd.Usage          = D3D11_USAGE_DYNAMIC;
121:	bd.BindFlags      = D3D11_BIND_INDEX_BUFFER;
122:	bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
123:	bd.MiscFlags      = 0;
124:
125:	HRESULT const hr = device->CreateBuffer(&bd, nullptr, &ms_d3dRingBuffer);
126:	FATAL_DX_HR("Direct3d11_DynamicIndexBufferData::CreateBuffer (dynamic IB ring) failed: %s", hr);
127:
128:	ms_usedNumberOfIndices             = 0;
129:	ms_newFrame                        = true;
130:	ms_locksSinceResourceCreation      = 0;
131:	ms_discardsSinceResourceCreation   = 0;
132:}
