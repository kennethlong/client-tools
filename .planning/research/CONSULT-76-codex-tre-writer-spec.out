  953: bool TreeFile::SearchTOC::localExists(const char *fileName, int *index) const
  954: {
  955: 	NOT_NULL(fileName);
  956: 	DEBUG_FATAL(strlen(fileName) + 1 > Os::MAX_PATH_LENGTH,("file name too long %d/%d", 
strlen(fileName) + 1, Os::MAX_PATH_LENGTH));
  957: 
  958: 	const uint32 crc = Crc::calculate(fileName);
  959: 
  960: 	// try a binary search through the tree file to find the file
  961: 	bool found       = false;
  962: 	int  left        = 0;
  963: 	int  right       = m_numberOfFiles - 1;
  964: 	int  mid         = 0;
  965: 	while (!found && (left <= right))
  966: 	{
  967: 		mid = (left + right) / 2;
  968: 
  969: 		if (m_tableOfContents[mid].crc < crc)
  970: 			left = mid + 1;
  971: 		else
  972: 			if (m_tableOfContents[mid].crc > crc)
  973: 				right = mid - 1;
  974: 			else
  975: 			{
  976: 				const int res = _stricmp(m_fileNames + m_tableOfContents[mid].fileNameOffset, fileName);
  977: 
  978: 				if (res < 0)
  979: 					left = mid + 1;
  980: 				else
  981: 					if (res > 0)
  982: 						right = mid - 1;
  983: 					else
  984: 						found = true;
  985: 			}
  986: 	}
  987: 
  988: 	// return the found index if desired
  989: 	if (found)
  990: 	{
  991: 		if (m_tableOfContents[mid].length == 0)
  992: 		{
  993: 			return false;
  994: 		}
  995: 		else if (m_tableOfContents[mid].offset == 0)
  996: 		{
  997: 			// sanity check - if the file has a length, but the offset is zero, the pointer in the TOC 
is invalid
  998: 			return false;
  999: 		}
 1000: 
 1001: 		if (index)
 1002: 			*index = mid;
 1003: 	}
 1004: 
 1005: 	return found;
 1006: }
