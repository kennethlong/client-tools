  388: bool TreeFile::SearchTree::validate(const char *fileName)
  389: {
  390: 	// open the file
  391: 	FileStreamer::File *file = FileStreamer::open(fileName);
  392: 	if (!file)
  393: 		return false;
  394: 
  395: 	// read the header
  396: 	Header header;
  397: 	const int readPos = file->read(0, &header, sizeof(header), AbstractFile::PriorityData);
  398: 
  399: 	// close the file
  400: 	delete file;
  401: 
  402: 	// make sure all the bytes were read
  403: 	if (readPos != isizeof(header))
  404: 		return false;
  405: 
  406: 	// validate the token
  407: 	if (header.token != TAG_TREE)
  408: 		return false;
  409: 
  410: 	// validate the version number
  411: 	if (header.version < TAG_0004 || header.version > TAG_0004)
  412: 		return false;
  413: 
  414: 	return true;
  415: }
