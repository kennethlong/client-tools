  139:     if version in RETAIL_TRE_VERSIONS or version == "5000":
  140:         return TOC_ENTRY_SIZE_RETAIL
  141:     if version in EXTENDED_TRE_VERSIONS:
  142:         return TOC_ENTRY_SIZE_EXTENDED
  143:     raise UnsupportedTreVersionError(
  144:         f"unsupported TRE version {version!r} (supported: {sorted(SUPPORTED_TRE_VERSIONS)})"
  145:     )
  146: 
  147: 
  148: def detect_master_index_kind(path: str | Path) -> MasterIndexKind:
  149:     data = Path(path).read_bytes()
  150:     if data.startswith(COT2000_MAGIC):
  151:         return MasterIndexKind.COT2000
  152:     if len(data) >= 8 and data[0:4] == TAG_TOC_LE and data[4:8] == TAG_0001_LE:
  153:         return MasterIndexKind.SEARCH_TOC
  154:     raise TreFormatError(
  155:         f"not a recognized master index: {path} (expected COT2000 or SearchTOC)"
  156:     )
  157: 
  158: 
  159: def read_tre_header(path: str | Path) -> TreHeader:
  160:     data = Path(path).read_bytes()
  161:     if len(data) < STANDARD_HEADER_SIZE:
  162:         raise TreFormatError(f"TRE too small: {path}")
  163:     token_b, version_b = struct.unpack_from("<4s4s", data, 0)
  164:     if token_b != TAG_TREE_LE:
  165:         raise TreFormatError(f"Not a TREE archive: {path} (token={token_b!r})")
  166:     version = tag_to_str(version_b)
  167:     if version not in SUPPORTED_TRE_VERSIONS:
  168:         raise UnsupportedTreVersionError(
  169:             f"unsupported TRE version {version!r} in {path} "
  170:             f"(supported: {sorted(SUPPORTED_TRE_VERSIONS)})"
  171:         )
  172:     nf, toc_off, toc_comp, sz_toc, blk_comp, sz_nb, uncomp_nb = struct.unpack_from(
  173:         "<7I", data, 8
  174:     )
  175:     return TreHeader(
  176:         path=Path(path),
  177:         token=tag_to_str(token_b),
  178:         version=version,
  179:         number_of_files=nf,
  180:         toc_offset=toc_off,
  181:         toc_compressor=toc_comp,
  182:         size_of_toc=sz_toc,
  183:         block_compressor=blk_comp,
  184:         size_of_name_block=sz_nb,
  185:         uncomp_size_of_name_block=uncomp_nb,
  186:     )
  187: 
  188: 
  189: def _decompress_block(raw: bytes, compressed: bool) -> bytes:
  190:     if not compressed:
  191:         return raw
  192:     return zlib.decompress(raw)
  193: 
  194: 
  195: def read_tre_entries(path: str | Path) -> list[TreEntry]:
  196:     p = Path(path)
  197:     data = p.read_bytes()
  198:     header = read_tre_header(p)
  199:     stride = toc_entry_stride(header.version)
  200:     toc_raw = data[header.toc_offset : header.toc_offset + header.size_of_toc]
  201:     toc_data = _decompress_block(toc_raw, header.toc_compressor != 0)
  202:     expected = header.number_of_files * stride
  203:     if len(toc_data) < expected:
  204:         raise TreFormatError(
  205:             f"TOC too small in {p.name}: got {len(toc_data)} bytes, need {expected} "
  206:             f"({header.number_of_files} x {stride})"
  207:         )
  208:     name_off = header.toc_offset + header.size_of_toc
  209:     name_raw = data[name_off : name_off + header.size_of_name_block]
  210:     names = _decompress_block(name_raw, header.block_compressor != 0)
  211:     entries: list[TreEntry] = []
  212:     for i in range(header.number_of_files):
  213:         base = i * stride
  214:         crc, length, offset, comp, clen, fnoff = struct.unpack_from(TOC_ENTRY_FMT, toc_data, 
base)
  215:         end = names.find(b"\0", fnoff)
  216:         if end < 0:
  217:             raise TreFormatError(f"Bad fileNameOffset {fnoff} in {p.name} entry {i}")
  218:         rel_path = names[fnoff:end].decode("latin1")
  219:         entries.append(
  220:             TreEntry(
  221:                 path=rel_path,
  222:                 crc=crc,
  223:                 length=length,
  224:                 offset=offset,
  225:                 compressor=comp,
  226:                 compressed_length=clen,
  227:             )
  228:         )
  229:     return entries
  230: 
  231: 
  232: def list_tre(path: str | Path) -> list[str]:
  233:     return [e.path for e in read_tre_entries(path)]
  234: 
  235: 
  236: def read_tre_payload(path: str | Path, logical_name: str) -> bytes:
  237:     """Read payload bytes for an entry (decompresses zlib when compressor is set)."""
  238:     p = Path(path)
  239:     header = read_tre_header(p)
  240:     data = p.read_bytes()
  241:     needle = logical_name.replace("\\", "/").lower()
  242:     for entry in read_tre_entries(p):
  243:         if entry.path.replace("\\", "/").lower() != needle:
  244:             continue
  245:         size = entry.compressed_length if entry.compressor else entry.length
  246:         raw = data[entry.offset : entry.offset + size]
  247:         if entry.compressor:
  248:             try:
  249:                 return zlib.decompress(raw)
  250:             except zlib.error as exc:
  251:                 from swg_pipeline.tre_decrypt import try_read_tre_payload
  252: 
  253:                 alt = try_read_tre_payload(raw, entry.compressor, version=header.version)
  254:                 if alt.ok:
  255:                     return alt.data
  256:                 raise TreFormatError(
  257:                     f"zlib decompress failed for {logical_name!r} in {p.name} "
  258:                     f"(compressor={entry.compressor}, version={header.version}). {alt.note}"
  259:                 ) from exc
  260:         return raw
  261:     raise KeyError(logical_name)
  262: 
  263: 
  264: def read_cot2000_header(path: str | Path) -> Cot2000Header:
  265:     p = Path(path)
  266:     data = p.read_bytes()
  267:     if not data.startswith(COT2000_MAGIC):
  268:         raise TreFormatError(f"Not a COT2000 file: {p} (magic={data[:8]!r})")
  269:     _reserved, n_files, sz_toc, sz_names, _dup_names, n_trees, sz_tree_names = 
struct.unpack_from(
  270:         "<7I", data, 8
  271:     )
  272:     pos = COT2000_TRE_NAME_OFFSET
  273:     tre_names: list[str] = []
  274:     for _ in range(n_trees):
  275:         end = data.find(b"\0", pos)
  276:         if end < 0:
  277:             raise TreFormatError(f"Truncated tree name block in {p.name}")
  278:         tre_names.append(data[pos:end].decode("ascii", errors="replace"))
  279:         pos = end + 1
  280:     toc_off = pos
  281:     name_off = toc_off + sz_toc
  282:     return Cot2000Header(
  283:         path=p,
  284:         number_of_files=n_files,
  285:         size_of_toc_block=sz_toc,
  286:         size_of_name_block=sz_names,
  287:         number_of_tree_files=n_trees,
  288:         size_of_tree_name_block=sz_tree_names,
  289:         tre_files=tuple(tre_names),
  290:         toc_block_offset=toc_off,
  291:         name_block_offset=name_off,
  292:     )
  293: 
  294: 
  295: def read_cot2000_entries(path: str | Path) -> list[Cot2000Entry]:
  296:     header = read_cot2000_header(path)
  297:     data = header.path.read_bytes()
  298:     names = data[header.name_block_offset : header.name_block_offset + 
header.size_of_name_block]
  299:     toc_base = header.toc_block_offset
  300:     raw_entries: list[tuple[int, int, int, int, int, int, int]] = []
  301:     for i in range(header.number_of_files):
  302:         off = toc_base + i * COT2000_GLOBAL_ENTRY_SIZE
  303:         comp, _, tree_idx, crc, fn_len, file_off, length, clen = struct.unpack_from(
  304:             COT2000_GLOBAL_ENTRY_FMT, data, off
  305:         )
  306:         raw_entries.append((comp, tree_idx, crc, fn_len, file_off, length, clen))
  307:     fn_offset = 0
  308:     entries: list[Cot2000Entry] = []
  309:     for comp, tree_idx, crc, fn_len, file_off, length, clen in raw_entries:
  310:         end = names.find(b"\0", fn_offset)
  311:         if end < 0:
  312:             raise TreFormatError(f"Bad name block at offset {fn_offset}")
  313:         rel_path = names[fn_offset:end].decode("latin1")
  314:         tre_file = header.tre_files[tree_idx] if tree_idx < len(header.tre_files) else "?"
  315:         entries.append(
  316:             Cot2000Entry(
  317:                 path=rel_path,
  318:                 tre_file=tre_file,
  319:                 tree_index=tree_idx,
  320:                 crc=crc,
  321:                 offset=file_off,
  322:                 length=length,
  323:                 compressor=comp,
  324:                 compressed_length=clen,
  325:             )
  326:         )
  327:         fn_offset += fn_len + 1
  328:     if fn_offset != header.size_of_name_block:
  329:         raise TreFormatError(
  330:             f"Name block size mismatch: walked {fn_offset}, header says 
{header.size_of_name_block}"
  331:         )
  332:     return entries
  333: 
  334: 
  335: def read_search_toc_header(path: str | Path) -> SearchTocHeader:
  336:     p = Path(path)
  337:     data = p.read_bytes()
  338:     if len(data) < SEARCH_TOC_HEADER_SIZE:
  339:         raise TreFormatError(f"SearchTOC too small: {p}")
  340:     token_b, version_b, toc_comp, name_comp, _u1, _u2, n_files, sz_toc, sz_nb, uncomp_nb, 
n_trees, sz_tree_names = (
  341:         struct.unpack_from(SEARCH_TOC_HEADER_FMT, data, 0)
  342:     )
  343:     if token_b != TAG_TOC_LE or version_b != TAG_0001_LE:
  344:         raise TreFormatError(f"Not a SearchTOC file: {p} (token={token_b!r} 
version={version_b!r})")
  345:     pos = SEARCH_TOC_HEADER_SIZE
  346:     tre_names: list[str] = []
  347:     for _ in range(n_trees):
  348:         end = data.find(b"\0", pos)
  349:         if end < 0:
  350:             raise TreFormatError(f"Truncated tree name block in {p.name}")
  351:         tre_names.append(data[pos:end].decode("latin1", errors="replace"))
  352:         pos = end + 1
  353:     return SearchTocHeader(
  354:         path=p,
  355:         number_of_files=n_files,
  356:         toc_compressor=toc_comp,
  357:         name_block_compressor=name_comp,
  358:         size_of_toc=sz_toc,
  359:         size_of_name_block=sz_nb,
  360:         uncomp_size_of_name_block=uncomp_nb,
  361:         number_of_tree_files=n_trees,
  362:         size_of_tree_file_name_block=sz_tree_names,
  363:         tre_files=tuple(tre_names),
  364:         toc_offset=pos,
  365:     )
  366: 
  367: 
  368: def read_search_toc_entries(path: str | Path) -> list[SearchTocEntry]:
  369:     header = read_search_toc_header(path)
  370:     data = header.path.read_bytes()
  371:     pos = header.toc_offset
  372:     toc_raw = data[pos : pos + header.size_of_toc]
  373:     pos += header.size_of_toc
  374:     toc_data = _decompress_block(toc_raw, header.toc_compressor != 0)
  375:     expected = header.number_of_files * SEARCH_TOC_ENTRY_SIZE
  376:     if len(toc_data) < expected:
  377:         raise TreFormatError(f"SearchTOC table too small in {header.path.name}")
  378:     raw_rows: list[tuple[int, int, int, int, int, int, int]] = []
  379:     for i in range(header.number_of_files):
  380:         off = i * SEARCH_TOC_ENTRY_SIZE
  381:         comp, _unused, tree_idx, crc, fn_field, file_off, length, clen = struct.unpack_from(
  382:             SEARCH_TOC_ENTRY_FMT, toc_data, off
  383:         )
  384:         raw_rows.append((comp, tree_idx, crc, fn_field, file_off, length, clen))
  385:     fn_offset = 0
  386:     path_fields: list[tuple[int, int, int, int, int, int, int]] = []
  387:     for comp, tree_idx, crc, fn_field, file_off, length, clen in raw_rows:
  388:         path_fields.append((comp, tree_idx, crc, fn_offset, file_off, length, clen))
  389:         fn_offset += fn_field + 1
  390:     name_raw = data[pos : pos + header.size_of_name_block]
  391:     names = _decompress_block(name_raw, header.name_block_compressor != 0)
  392:     if len(names) < header.uncomp_size_of_name_block:
  393:         raise TreFormatError(f"Short name block in {header.path.name}")
  394:     entries: list[SearchTocEntry] = []
  395:     for comp, tree_idx, crc, fnoff, file_off, length, clen in path_fields:
  396:         end = names.find(b"\0", fnoff)
  397:         if end < 0:
  398:             raise TreFormatError(f"Bad filename offset {fnoff}")
  399:         rel = names[fnoff:end].decode("latin1")
  400:         tre = header.tre_files[tree_idx] if tree_idx < len(header.tre_files) else "?"
  401:         entries.append(
  402:             SearchTocEntry(
  403:                 path=rel,
  404:                 tre_file=tre,
  405:                 tree_index=tree_idx,
  406:                 crc=crc,
  407:                 offset=file_off,
  408:                 length=length,
  409:                 compressor=comp,
  410:                 compressed_length=clen,
  411:             )
  412:         )
  413:     return entries
  414: 
  415: 
  416: def parse_cot2000(path: str | Path) -> dict:
  417:     header = read_cot2000_header(path)
  418:     entries = read_cot2000_entries(path)
  419:     ext_counts: dict[str, int] = {}
  420:     for entry in entries:
  421:         if "." in entry.path:
  422:             ext = entry.path.rsplit(".", 1)[-1].lower()
  423:             ext_counts[ext] = ext_counts.get(ext, 0) + 1
  424:     return {
  425:         "kind": MasterIndexKind.COT2000.value,
  426:         "path": header.path,
  427:         "tre_files": list(header.tre_files),
  428:         "indexed_path_count": len(entries),
  429:         "indexed_paths_sample": [e.path for e in entries[:20]],
  430:         "extension_counts": ext_counts,
  431:         "header": header,
  432:     }
  433: 
  434: 
  435: def parse_search_toc(path: str | Path) -> dict:
  436:     header = read_search_toc_header(path)
  437:     entries = read_search_toc_entries(path)
  438:     ext_counts: dict[str, int] = {}
  439:     for entry in entries:
  440:         if "." in entry.path:
  441:             ext = entry.path.rsplit(".", 1)[-1].lower()
  442:             ext_counts[ext] = ext_counts.get(ext, 0) + 1
  443:     return {
  444:         "kind": MasterIndexKind.SEARCH_TOC.value,
  445:         "path": header.path,
  446:         "tre_files": list(header.tre_files),
  447:         "indexed_path_count": len(entries),
  448:         "indexed_paths_sample": [e.path for e in entries[:20]],
  449:         "extension_counts": ext_counts,
  450:         "header": header,
  451:     }
  452: 
  453: 
  454: def parse_master_index(path: str | Path) -> dict:
  455:     kind = detect_master_index_kind(path)
  456:     if kind == MasterIndexKind.COT2000:
  457:         return parse_cot2000(path)
  458:     return parse_search_toc(path)
  459: 
  460: 
  461: def parse_toc2000(path: str | Path) -> dict:
  462:     """Alias for parse_cot2000 (legacy name)."""
  463:     return parse_cot2000(path)
  464: 
  465: 
  466: def backup_tre(path: str | Path, suffix: str = ".bak") -> Path:
  467:     src = Path(path)
  468:     dest = src.with_suffix(src.suffix + suffix)
  469:     shutil.copy2(src, dest)
  470:     return dest

