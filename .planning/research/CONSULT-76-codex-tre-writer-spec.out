"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
import struct, binascii, zlib
p=Path('tests/golden/retail_mini_0005.tre')
data=p.read_bytes()
print('len', len(data))
print('first36hex', data[:36].hex(' '))
print(struct.unpack_from('<4s4s7I', data, 0))
_,_,nf,toc_off,toc_comp,sz_toc,blk_comp,sz_nb,uncomp=struct.unpack_from('<4s4s7I', data,0)
toc_raw=data[toc_off:toc_off+sz_toc]
print('toc raw len', len(toc_raw), 'hex', toc_raw.hex(' '))
toc=zlib.decompress(toc_raw) if toc_comp else toc_raw
print('toc data len', len(toc), 'hex', toc.hex(' '))
for i in range(nf): print(i, struct.unpack_from('<Iiiiii',toc,i*24))
name_off=toc_off+sz_toc
name_raw=data[name_off:name_off+sz_nb]
print('name raw len',len(name_raw),'hex', name_raw.hex(' '))
names=zlib.decompress(name_raw) if blk_comp else name_raw
print('names',names, len(names))
for i in range(nf):
 crc,l,off,comp,clen,fnoff=struct.unpack_from('<Iiiiii',toc,i*24)
 size=clen if comp else l
 print('payload',i,off,size,data[off:off+size].hex(' '), data[off:off+size])
