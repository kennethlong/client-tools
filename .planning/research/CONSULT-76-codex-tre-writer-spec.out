  599: // ----------------------------------------------------------------------
  600: 
  601: void TreeFileBuilder::writeTableOfContents()
  602: {
  603: 	TreeFile::SearchTree::TableOfContentsEntry  entry;
  604: 
  605: 	int uncompSizeOfTOC = sizeof(entry) * numberOfFiles;
  606: 	int currentOffset   = 0;
  607: 
  608: 	std::vector<FileEntry*>::iterator iter = tocOrder.begin();
  609: 
  610: 	byte *uncompressed = new byte[uncompSizeOfTOC];
  611: 	byte *uncompIter   = uncompressed;
  612: 
  613: 	// compress and write all of the file TOC info
  614: 	for (; iter != tocOrder.end(); ++iter, uncompIter += sizeof(entry))
  615: 	{
  616: 		// prepare entry by zeroing out the total size of data to be stored
  617: 		memset(&entry, 0, sizeof(entry));
  618: 
  619: 		entry.crc                = (*iter)->treeFileEntry.getCrc();
  620: 		entry.length             = (*iter)->length;
  621: 		entry.offset             = (*iter)->offset;
  622: 		entry.compressor         = (*iter)->compressor;
  623: 		entry.compressedLength   = (*iter)->compressedLength;
  624: 		entry.fileNameOffset     = currentOffset;
  625: 		currentOffset           += strlen((*iter)->treeFileEntry.getString()) + 1;
  626: 
  627: 		// copy the entry
  628: 		memcpy(uncompIter, &entry, sizeof(entry));
  629: 		fileNameBlock.push_back((*iter)->treeFileEntry.getString());
  630: 	}
  631: 
  632: 	compressAndWrite(uncompressed, sizeOfTOC, uncompSizeOfTOC, tocCompressorID, false, 
disableTOCCompression, NULL);
  633: 	delete [] uncompressed;
  634: }
