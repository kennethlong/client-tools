    1: """Wrap TreeFileExtractor / TreeFileBuilder and provide a unified CLI (Phase 14)."""
    2: 
    3: from __future__ import annotations
    4: 
    5: import argparse
    6: import os
    7: import json
    8: import shutil
    9: import subprocess
   10: import sys
   11: from pathlib import Path
   12: 
   13: _DEFAULT_EXE_DIRS = [
   14:     Path("tools"),
   15:     Path("exe/win32"),
   16:     Path("src/engine/shared/application/TreeFileExtractor/build/win32/Release"),
   17:     Path("src/engine/shared/application/TreeFileBuilder/build/win32/Release"),
   18: ]
   19: 
   20: def _swg_client_root() -> Path:
   21:     env = os.environ.get("SWG_CLIENT_ROOT", "").strip()
   22:     if env:
   23:         return Path(env)
   24:     sibling = Path(__file__).resolve().parents[1].parent / "swg-client-v2"
   25:     return sibling if sibling.is_dir() else Path(__file__).resolve().parents[1]
   26: 
   27: 
   28: SWG_ROOT = _swg_client_root()
   29: 
   30: 
   31: class TreToolError(RuntimeError):
   32:     pass
   33: 
   34: 
   35: def find_tool(name: str, exe_dirs: list[Path] | None = None) -> Path | None:
   36:     candidates = exe_dirs or _DEFAULT_EXE_DIRS
   37:     for d in candidates:
   38:         p = (SWG_ROOT / d / f"{name}.exe") if not d.is_absolute() else d / f"{name}.exe"
   39:         if p.is_file():
   40:             return p
   41:     found = shutil.which(name)
   42:     return Path(found) if found else None
   43: 
   44: 
   45: def extract_tre(
   46:     tre_path: str | Path,
   47:     out_dir: str | Path,
   48:     tool: Path | None = None,
   49: ) -> subprocess.CompletedProcess:
   50:     exe = tool or find_tool("TreeFileExtractor")
   51:     if not exe:
   52:         raise TreToolError("TreeFileExtractor.exe not found.")
   53:     out_dir = Path(out_dir)
   54:     out_dir.mkdir(parents=True, exist_ok=True)
   55:     return subprocess.run([str(exe), "-e", str(tre_path), str(out_dir)], capture_output=True, 
text=True)
   56: 
   57: 
   58: def list_tre_exe(tre_path: str | Path, tool: Path | None = None) -> 
subprocess.CompletedProcess:
   59:     exe = tool or find_tool("TreeFileExtractor")
   60:     if not exe:
   61:         raise TreToolError("TreeFileExtractor.exe not found.")
   62:     return subprocess.run([str(exe), "-l", str(tre_path)], capture_output=True, text=True)
   63: 
   64: 
   65: def pack_tre(
   66:     rsp_path: str | Path,
   67:     out_tre: str | Path,
   68:     tool: Path | None = None,
   69:     no_toc_compress: bool = False,
   70: ) -> subprocess.CompletedProcess:
   71:     exe = tool or find_tool("TreeFileBuilder")
   72:     if not exe:
   73:         raise TreToolError("TreeFileBuilder.exe not found.")
   74:     rsp = Path(rsp_path).resolve()
   75:     out = Path(out_tre).resolve()
   76:     work = rsp.parent
   77:     cmd = [str(exe), "-r", rsp.name]
   78:     if no_toc_compress:
   79:         cmd.append("-t")
   80:     try:
   81:         tre_arg = os.path.relpath(out, work)
   82:     except ValueError:
   83:         tre_arg = str(out)
   84:     cmd.append(tre_arg)
   85:     # Legacy TreeFileBuilder CLI cannot parse long absolute paths (pytest temps).
   86:     return subprocess.run(cmd, cwd=work, capture_output=True, text=True)
   87: 
   88: 
   89: def _cmd_pack(args: argparse.Namespace) -> int:
   90:     from swg_pipeline.pack_pipeline import pack_rsp_file
   91: 
   92:     try:
   93:         result = pack_rsp_file(
   94:             args.rsp,
   95:             args.output,
   96:             no_toc_compress=args.no_toc_compress,
   97:             verify=not args.no_verify,
   98:         )
   99:     except Exception as exc:
  100:         print(f"ERROR: {exc}", file=sys.stderr)
  101:         return 1
  102:     payload = {
  103:         "rsp": str(result.rsp_path),
  104:         "tre": str(result.tre_path),
  105:         "files": result.file_count,
  106:         "version": result.version,
  107:     }
  108:     if args.json:
  109:         print(json.dumps(payload, indent=2))
  110:     else:
  111:         print(result.tre_path)
  112:     return 0
  113: 
  114: 
  115: def _cmd_extract(args: argparse.Namespace) -> int:
  116:     try:
  117:         proc = extract_tre(args.tre, args.out)
  118:     except TreToolError as exc:
  119:         print(f"ERROR: {exc}", file=sys.stderr)
  120:         return 1
  121:     if proc.returncode != 0:
  122:         print((proc.stderr or proc.stdout or "extract failed").strip(), file=sys.stderr)
  123:         return proc.returncode
  124:     if not args.silent:
  125:         print(args.out)
  126:     return 0
  127: 
  128: 
  129: def _cmd_list(args: argparse.Namespace) -> int:
  130:     if args.python_reader:
  131:         from swg_pipeline.tre_reader import list_tre
  132: 
  133:         try:
  134:             for path in list_tre(args.tre):
  135:                 print(path)
  136:         except (OSError, ValueError) as exc:
  137:             print(f"ERROR: {exc}", file=sys.stderr)
  138:             return 1
  139:         return 0
  140:     try:
  141:         proc = list_tre_exe(args.tre)
  142:     except TreToolError as exc:
  143:         print(f"ERROR: {exc}", file=sys.stderr)
  144:         return 1
  145:     if proc.returncode != 0:
  146:         print((proc.stderr or proc.stdout or "list failed").strip(), file=sys.stderr)
  147:         return proc.returncode
  148:     if proc.stdout and not args.silent:
  149:         sys.stdout.write(proc.stdout)
  150:     return 0
  151: 
  152: 
  153: def main(argv: list[str] | None = None) -> int:
  154:     parser = argparse.ArgumentParser(description="SWG TRE pack/extract/list tools")
  155:     parser.add_argument("-silent", action="store_true", help="suppress non-error stdout")
  156:     sub = parser.add_subparsers(dest="command", required=True)
  157: 
  158:     pack_p = sub.add_parser("pack", help="pack one .rsp into a .tre (TreeFileBuilder)")
  159:     pack_p.add_argument("--rsp", type=Path, required=True)
  160:     pack_p.add_argument("--output", type=Path, required=True, help="output .tre path")
  161:     pack_p.add_argument("--no-toc-compression", action="store_true")
  162:     pack_p.add_argument("--no-verify", action="store_true", help="skip post-pack tre_reader 
check")
  163:     pack_p.add_argument("--json", action="store_true")
  164: 
  165:     ext_p = sub.add_parser("extract", help="extract .tre to loose files (TreeFileExtractor)")
  166:     ext_p.add_argument("--tre", type=Path, required=True)
  167:     ext_p.add_argument("--out", type=Path, required=True)
  168: 
  169:     list_p = sub.add_parser("list", help="list paths inside a .tre")
  170:     list_p.add_argument("--tre", type=Path, required=True)
  171:     list_p.add_argument(
  172:         "--python-reader",
  173:         action="store_true",
  174:         help="use swg_pipeline.tre_reader (retail zlib; no extractor required)",
  175:     )
  176: 
  177:     args = parser.parse_args(argv)
  178:     if args.command == "pack":
  179:         return _cmd_pack(args)
  180:     if args.command == "extract":
  181:         return _cmd_extract(args)
  182:     if args.command == "list":
  183:         return _cmd_list(args)
  184:     return 2
  185: 
  186: 
  187: if __name__ == "__main__":
  188:     raise SystemExit(main())

