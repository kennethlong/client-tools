  563: 			printf("  storing deleted file %s\n", fileEntry->treeFileEntry.getString());
  564: 
  565: 		return;
  566: 	}
  567: 
  568: 	const char *fileName = fileEntry->diskFileEntry;
  569: 
  570: 	HANDLE handle = CreateFile(fileName, GENERIC_READ, 0, NULL, OPEN_EXISTING, 
FILE_ATTRIBUTE_NORMAL, NULL);
  571: 
  572: 	// get the file length
  573: 	const int fileLength = static_cast<int>(GetFileSize(handle, NULL));
  574: 
  575: 	// read the file into a buffer
  576: 	byte *uncompressed = new byte[fileLength];
  577: 
  578: 	DWORD red;
  579: 	BOOL b = ReadFile(handle, uncompressed, fileLength, &red, NULL);
  580: 
  581: 	FATAL(!b || red != static_cast<DWORD>(fileLength), ("could not read file %s\n", fileName));
  582: 
  583: 	// close the file
  584: 	b = CloseHandle(handle);
  585: 
  586: 	FATAL(!b, ("could not close file %s\n", fileName));
  587: 
  588: 	// store the info about this file
  589: 	fileEntry->length     = fileLength;
  590: 	fileEntry->offset     = SetFilePointer(treeFileHandle, 0, NULL, FILE_CURRENT);
  591: 
  592: 	// variable determining whether file compression is disabled or not
  593: 	bool disableCompression = (disableFileCompression || fileEntry->uncompressed);
  594: 
  595: 	compressAndWrite(uncompressed, fileEntry->compressedLength, fileLength, 
fileEntry->compressor, true, disableCompression, &fileEntry->md5);
  596: 	delete [] uncompressed;
  597: }
