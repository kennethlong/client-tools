   56:         raise PackError(f"rsp not found: {rsp}")
   57:     if find_tool("TreeFileBuilder") is None:
   58:         raise PackError("TreeFileBuilder.exe not found (build swg.sln or add to PATH)")
   59: 
   60:     out.parent.mkdir(parents=True, exist_ok=True)
   61:     proc = pack_tre(rsp, out, no_toc_compress=no_toc_compress)
   62:     if proc.returncode != 0:
   63:         err = (proc.stderr or proc.stdout or "").strip()
   64:         raise PackError(f"TreeFileBuilder failed ({proc.returncode}): {err}")
   65: 
   66:     file_count = 0
   67:     version = ""
