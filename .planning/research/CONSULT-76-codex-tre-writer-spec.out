  439: 	DEBUG_FATAL(header.token != TAG_TREE, ("file does not look like a tree file"));
  440: 
  441: 	// set to the number of files that has been compressed within the tree file
  442: 	m_numberOfFiles = static_cast<int>(header.numberOfFiles);
  443: 
  444: 	int readPosition = header.tocOffset;
  445: 	m_version = header.version;
  446: 	switch (m_version)
  447: 	{
  448: 		case TAG_0004:
  449: 		case TAG_0005:
  450: 			{
  451: 				m_tableOfContents = new TableOfContentsEntry[m_numberOfFiles];
  452: 				m_fileNames = new char [header.uncompSizeOfNameBlock];
  453: 
  454: 				// prepare table of contents by zeroing out the total size of data to be stored
  455: 				const int tableOfContentsSize = isizeof(TableOfContentsEntry) * m_numberOfFiles;
  456: 				memset(m_tableOfContents, 0, tableOfContentsSize);
  457: 
  458: 				if (isCompressed(header.tocCompressor))
  459: 				{
  460: 					// create temp buffer to store the compressed TOC entry data
  461: 					byte *entryBuffer = new byte[static_cast<uint32>(header.sizeOfTOC)];
  462: 				
  463: 					// read the compressed table of contents data into buffer
  464: 					const int bytesRead = m_treeFile->read(readPosition, entryBuffer, header.sizeOfTOC, 
AbstractFile::PriorityData);					
  465: 					DEBUG_FATAL(bytesRead != static_cast<int>(header.sizeOfTOC), ("failed to read tree file 
TOC entries"));
  466: 					readPosition += bytesRead;
  467: 
  468: 					// decompress data into toc 
  469: 					static_cast<void>(ZlibCompressor().expand(entryBuffer, header.sizeOfTOC, 
m_tableOfContents, tableOfContentsSize));
  470: 
  471: 					delete [] entryBuffer;
  472: 				}
  473: 				else
  474: 				{
  475: 					// read the uncompressed table of contents data
  476: 					const int bytesRead = m_treeFile->read(header.tocOffset, m_tableOfContents, 
tableOfContentsSize, AbstractFile::PriorityData);
  477: 					DEBUG_FATAL(bytesRead != tableOfContentsSize, ("failed to read tree file tableOfContents 
entries"));
  478: 					readPosition += bytesRead;
  479: 				}
  480: 
  481: 				if (header.blockCompressor)
  482: 				{
  483: 					// create temp buffer to store the compressed name block data
  484: 					byte *nameBuffer  = new byte[static_cast<uint32>(header.sizeOfNameBlock)];
  485: 
  486: 					// read the compressed table of contents data into buffer
  487: 					const int bytesRead = m_treeFile->read(readPosition, nameBuffer, header.sizeOfNameBlock, 
AbstractFile::PriorityData);					
  488: 					UNREF(bytesRead);
  489: 					DEBUG_FATAL(bytesRead != static_cast<int>(header.sizeOfNameBlock), ("failed to read tree 
file name block"));
  490: 
  491: 					// decompress data into tocFileNames 
  492: 					static_cast<void>(ZlibCompressor().expand(nameBuffer, header.sizeOfNameBlock, 
