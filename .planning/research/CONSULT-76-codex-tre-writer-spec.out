   64: //   The constructor will copy its argument into local memory, and then
   65: //   call CrcLowerString::calculateCrc() on the string to compute the CRC once.
   66: //
   67: // See Also:
   68: //
   69: //   CrcLowerString::calculateCrc()
   70: 
   71: CrcLowerString::CrcLowerString(const char *newString)
   72: : PersistentCrcString(newString, true)
   73: {
   74: }
   75: 
   76: // ----------------------------------------------------------------------
   77: /**
   78:  * Construct a new CrcLowerString.
   79:  * 
   80:  * The constructor will copy its argument into local memory.  It will
   81:  * assume that the specified CRC is correct for the string.
   82:  * 
   83:  * @param newString  String to generate the CRC String from
   84:  * @param newCrc  CRC for the string
   85:  */
   86: 
   87: CrcLowerString::CrcLowerString(const char *newString, uint32 newCrc)
   88: : PersistentCrcString(newString, newCrc)
   89: {
   90: }
  157: int CrcLowerString::compare(const char *otherString, uint32 otherCrc) const
  158: {
  159: 	NOT_NULL(otherString);
  160: 
  161: 	const uint32 crc = getCrc();
  162: 
  163: 	if (crc < otherCrc)
  164: 		return -1;
  165: 
  166: 	if (crc > otherCrc)
  167: 		return 1;
  168: 
  169: 	char const *string = getString();
  170: 	for (int i = 0; ; ++i)
  171: 	{
  172: 		const int a = string[i];
  173: 		const int b = tolower(otherString[i]);
  174: 
  175: 		if (!a || !b || a != b)
  176: 		{
  177: 			if (a < b)
  178: 				return -1;
  179: 
  180: 			if (a > b)
  181: 				return 1;
  182: 
  183: 			if (a == b)
  184: 				return 0;
  185: 		}
  186: 	}
  187: }
  188: 
  189: // ----------------------------------------------------------------------
  190: /**
  191:  * Compare this CrcLowerString with another.
  192:  * 
  193:  * The return value does not indicate the lexiographic ordering of the
  194:  * strings, because they are first compared using the CRC, and only if
  195:  * the CRC's match are they compared by strcmp().
  196:  * 
  197:  * @param otherString  CrcLowerString to compare against
  198:  * @return See Remarks section
  199:  */

