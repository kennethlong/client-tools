   54: def test_build_search_toc_roundtrip(tmp_path: Path):
   55:     """Minimal retail SearchTOC master index (synthetic)."""
   56:     tre_name = b"patch_00.tre\x00"
   57:     names = b"appearance/x.msh\x00"
   58:     toc_entry = struct.pack("<BBHIIIII", 0, 0, 0, 0, len(b"appearance/x.msh"), 100, 4, 4)
   59:     hdr = struct.pack(
   60:         "<4s4sBBBBIIIIII",
   61:         TAG_TOC_LE,
   62:         TAG_0001_LE,
   63:         0,
   64:         0,
   65:         0,
   66:         0,
   67:         1,
   68:         len(toc_entry),
   69:         len(names),
   70:         len(names),
   71:         1,
   72:         len(tre_name),
   73:     )
   74:     toc_path = tmp_path / "master.toc"
   75:     toc_path.write_bytes(hdr + tre_name + toc_entry + names)
   76: 
   77:     assert detect_master_index_kind(toc_path) == MasterIndexKind.SEARCH_TOC
   78:     info = parse_master_index(toc_path)
   79:     assert info["kind"] == "search_toc"
   80:     assert info["indexed_path_count"] == 1
   81:     assert info["indexed_paths_sample"][0] == "appearance/x.msh"
   82: 
   83:     header = read_search_toc_header(toc_path)
   84:     assert header.number_of_files == 1
   85:     assert header.tre_files == ("patch_00.tre",)
   86:     entries = read_search_toc_entries(toc_path)
   87:     assert entries[0].path == "appearance/x.msh"
   88:     assert entries[0].tre_file == "patch_00.tre"
   89:     assert entries[0].offset == 100

