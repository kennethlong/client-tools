  676: void TreeFileBuilder::compressAndWrite(const byte *uncompressed, int &sizeOfData, const int 
uncompressedSize, int &compressor, const bool isFileData, const bool disableCompression, Md5::Value 
*md5)
  677: {
  678: 	int smallest = TreeFile::SearchTree::CT_none;
  679: 	int smallestSize = uncompressedSize;
  680: 	byte * smallestBuffer = NULL;
  681: 
  682: 	if (!disableCompression && uncompressedSize > 1024)
  683: 	{
  684: 		// try every compressor on the buffer
  685: 		TreeFile::SearchTree::CompressorType compressors[] =
  686: 		{
  687: 			TreeFile::SearchTree::CT_zlib
  688: 		};
  689: 		int const numberOfCompressors = sizeof(compressors) / sizeof(compressors[0]);
  690: 
  691: 		for (int i = 0; i < numberOfCompressors; i++)
  692: 		{
  693: 			TreeFile::SearchTree::CompressorType compressorType = compressors[i];
  694: 
  695: 			// make a temporary buffer
  696: 			int newBufferLength = uncompressedSize * 2;
  697: 			byte *newBuffer = new byte[newBufferLength];
  698: 
  699: 			// try the compressor on this data
  700: 			Compressor *compressor = TreeFile::SearchTree::borrowCompressor(compressorType);
  701: 			int size = compressor->compress(uncompressed, uncompressedSize, newBuffer, 
newBufferLength);
  702: 			TreeFile::SearchTree::returnCompressor(compressorType, compressor);
  703: 			compressor = NULL;
  704: 
  705: 			if (size < smallestSize)
  706: 			{
  707: 				// this compressor beat our old compressor and it compressed the original data by at 
least 512 bytes
  708: 				smallestSize = size;
  709: 				smallest = compressorType;
  710: 				delete [] smallestBuffer;
  711: 				smallestBuffer = newBuffer;
  712: 			}
  713: 			else
  714: 			{
  715: 				// this compressor lost, too bad
  716: 				delete [] newBuffer;
  717: 			}
  718: 		}
  719: 	}
  720: 
  721: 	// if file data, print out compression summary for each file
  722: 	if (isFileData)
  723: 	{
  724: 		if (TreeFile::SearchTree::isCompressed(smallest))
  725: 		{
  726: 			if (quiet < 2)
  727: 				printf("  storing compressed(%d)   - OrigSize: %6d  CmpSize: %6d  Ratio: %3d%%\n", 
smallest, uncompressedSize, smallestSize, 100 - ((smallestSize * 100) / uncompressedSize));
  728: 			sizeOfData = smallestSize;
  729: 			write(smallestBuffer, smallestSize);
  730: 		}
  731: 		else

